@model ShoppingCart

@{
    ViewData["Title"] = "Shopping Cart";
}

<!-- Page Header -->
<div class="mb-4 animate-fade-in-up">
    <h1 class="fw-bold mb-1" style="color: var(--text-primary);">
        <i class="fas fa-shopping-cart me-2 text-gradient"></i>Your Shopping Cart
    </h1>
    <p class="mb-0" style="color: var(--text-muted); font-size: 0.92rem;">Manage items, update quantities, and prepare for checkout</p>
</div>

<!-- Stock/Quantity validation errors display -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center p-3 mb-4" role="alert" style="background: var(--danger-bg); border: 1px solid var(--danger-border); color: var(--danger); box-shadow: var(--shadow-sm);">
        <i class="fas fa-exclamation-triangle fs-5 me-2" style="color: var(--danger);"></i>
        <div class="small fw-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

@if (Model?.Items?.Any() == true)
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8 animate-fade-in-up">
            <div class="card border-0 overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color) !important; box-shadow: var(--shadow-md); border-radius: var(--radius-lg);">
                <div class="card-header p-3 d-flex align-items-center justify-content-between" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-list" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Shopping Items (@Model.Items.Sum(i => i.Quantity))
                    </h6>
                </div>
                <div class="cart-table">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-item d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem;">
                            <!-- Product Image -->
                            <div class="d-flex align-items-center gap-3">
                                <div class="cart-item-image ratio ratio-1x1 overflow-hidden" style="width: 80px; height: 80px; flex-shrink: 0; border-radius: var(--radius-md); border: 1px solid var(--border-color); background: var(--bg-tertiary);">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="object-fit-cover w-100 h-100" alt="@item.ProductName"
                                             onerror="this.outerHTML='<div class=\'d-flex align-items-center justify-content-center h-100 w-100\' style=\'color: var(--text-muted); font-size: 1.5rem;\'><i class=\'fas fa-box\'></i></div>';" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 w-100" style="color: var(--text-muted); font-size: 1.5rem;">
                                            <i class="fas fa-box"></i>
                                        </div>
                                    }
                                </div>

                                <!-- Product Name & SKU/ID Info -->
                                <div>
                                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.ProductId"
                                       class="fw-bold text-decoration-none d-block" style="color: var(--text-primary); font-size: 0.95rem; transition: color 0.2s ease;">
                                        @item.ProductName
                                    </a>
                                    <p class="small mb-0 mt-1" style="font-size: 0.75rem; color: var(--text-muted);">Item ID: @item.ProductId</p>
                                </div>
                            </div>

                            <!-- Unit Price display -->
                            <div class="d-flex flex-row flex-md-column justify-content-between align-items-md-end w-100-mobile">
                                <span class="small d-md-none" style="color: var(--text-muted);">Unit Price</span>
                                <div>
                                    <span class="fw-semibold" style="color: var(--text-primary);">$@item.Price.ToString("F2")</span>
                                </div>
                            </div>

                            <!-- Quantity Field Form -->
                            <div class="d-flex flex-row flex-md-column justify-content-between align-items-md-center w-100-mobile">
                                <span class="small d-md-none" style="color: var(--text-muted);">Quantity</span>
                                <div>
                                    <form method="post" asp-controller="Cart" asp-action="UpdateQuantity" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="999"
                                               class="form-control form-control-sm text-center fw-bold py-1 px-2"
                                               style="width: 70px; border-radius: var(--radius-sm); border: 1.5px solid var(--border-color); background: var(--bg-input); color: var(--text-primary);" onchange="this.form.submit()">
                                    </form>
                                </div>
                            </div>

                            <!-- Subtotal display -->
                            <div class="d-flex flex-row flex-md-column justify-content-between align-items-md-end w-100-mobile">
                                <span class="small d-md-none" style="color: var(--text-muted);">Subtotal</span>
                                <div>
                                    <span class="fw-bold text-gradient">$@item.Subtotal.ToString("F2")</span>
                                </div>
                            </div>

                            <!-- Remove action form button -->
                            <div class="text-end w-100-mobile mt-2 mt-md-0">
                                <form method="post" asp-controller="Cart" asp-action="RemoveFromCart" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId">
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1 fw-semibold w-100-mobile" style="border-radius: var(--radius-sm);">
                                        <i class="fas fa-trash-alt me-1"></i>Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Back navigation button -->
            <div class="mt-4">
                <a class="btn btn-outline-secondary px-4 py-2 fw-semibold" asp-controller="Home" asp-action="Index" style="border-radius: var(--radius-md);">
                    <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
        </div>

        <!-- Order Summary & Checkout -->
        <div class="col-lg-4 animate-fade-in-up delay-1">
            <div class="glass-card overflow-hidden mb-4" style="position: sticky; top: 90px; z-index: 10; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);">
                <!-- Gradient top bar -->
                <div style="height: 4px; background: var(--accent-gradient);"></div>
                <div class="p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-receipt" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Order Summary
                    </h6>
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between pb-3 mb-3 small" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Subtotal</span>
                        <span class="fw-bold" style="color: var(--text-primary);">$@Model.Total.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between pb-3 mb-3 small" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Shipping</span>
                        <span class="fw-bold" style="color: var(--success);">Free Delivery</span>
                    </div>
                    <div class="d-flex justify-content-between pb-3 mb-3 small" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Estimated Tax</span>
                        <span class="fw-bold" style="color: var(--text-primary);">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2 mb-4 fs-5 fw-bold">
                        <span style="color: var(--text-primary);">Order Total</span>
                        <span class="text-gradient">$@Model.Total.ToString("F2")</span>
                    </div>

                    <div class="d-grid">
                        <a class="btn btn-primary btn-lg py-3 fw-bold" asp-controller="Checkout" asp-action="Index" style="border-radius: var(--radius-md); box-shadow: 0 8px 25px var(--accent-glow);">
                            <i class="fas fa-lock me-2"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Trust / Guarantee Badge -->
            <div class="overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
                <div class="p-3">
                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex align-items-center gap-2" style="color: var(--text-secondary);">
                            <span class="d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: var(--success-bg); flex-shrink: 0;">
                                <i class="fas fa-shield-alt" style="color: var(--success);"></i>
                            </span>
                            <span>Secure SSL Checkout Encrypted</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" style="color: var(--text-secondary);">
                            <span class="d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: var(--success-bg); flex-shrink: 0;">
                                <i class="fas fa-undo" style="color: var(--success);"></i>
                            </span>
                            <span>30-Day Money Back Guarantee</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Empty Cart Placeholder State -->
    <div class="text-center py-5 mt-3 animate-fade-in-up" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-xl); box-shadow: var(--shadow-md);">
        <div class="d-inline-flex align-items-center justify-content-center mb-4 animate-scale-in" style="width: 100px; height: 100px; border-radius: 50%; background: var(--accent-glow);">
            <i class="fas fa-shopping-cart text-gradient" style="font-size: 2.5rem;"></i>
        </div>
        <h3 class="fw-bold" style="color: var(--text-primary);">Your cart is empty</h3>
        <p class="mb-4" style="max-width: 400px; margin: 0 auto; color: var(--text-muted);">It looks like you haven't added any products to your shopping cart yet. Discover our premium catalog and find the best electronics today!</p>
        <a class="btn btn-primary btn-lg px-5 py-3 mt-2" asp-controller="Home" asp-action="Index" style="border-radius: var(--radius-md); box-shadow: 0 8px 25px var(--accent-glow);">
            <i class="fas fa-store me-2"></i>Start Shopping
        </a>
    </div>
}
