@model ShoppingCart

@{
    ViewData["Title"] = "Shopping Cart";
}

<!-- Page Header -->
<div class="mb-4">
    <h1 class="fw-bold text-dark mb-0">
        <i class="fas fa-shopping-cart text-primary me-2"></i>Your Shopping Cart
    </h1>
    <p class="text-muted small mb-0">Manage items, update quantities, and prepare for checkout</p>
</div>

<!-- Stock/Quantity validation errors display -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center shadow-sm p-3 mb-4" role="alert">
        <i class="fas fa-exclamation-triangle fs-5 text-danger me-2"></i>
        <div class="small fw-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

@if (Model?.Items?.Any() == true)
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-list me-2 text-primary"></i>
                        <span>Shopping Items (@Model.Items.Sum(i => i.Quantity))</span>
                    </h6>
                </div>
                <div class="cart-table">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-item border-bottom p-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                            <!-- Product Image -->
                            <div class="d-flex align-items-center gap-3">
                                <div class="cart-item-image ratio ratio-1x1 bg-light rounded overflow-hidden shadow-xs border" style="width: 80px; height: 80px; flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="object-fit-cover w-100 h-100" alt="@item.ProductName"
                                             onerror="this.outerHTML='<div class=\'d-flex align-items-center justify-content-center bg-light text-muted fs-3\'><i class=\'fas fa-box\'></i></div>';" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light text-muted fs-3">
                                            <i class="fas fa-box"></i>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Product Name & SKU/ID Info -->
                                <div>
                                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.ProductId" 
                                       class="fw-bold text-dark text-decoration-none hover-link" style="font-size: 0.95rem;">
                                        @item.ProductName
                                    </a>
                                    <p class="text-muted small mb-0 mt-1" style="font-size: 0.75rem;">Item ID: @item.ProductId</p>
                                </div>
                            </div>

                            <!-- Unit Price display -->
                            <div class="d-flex flex-row flex-md-column justify-content-between align-items-md-end w-100-mobile">
                                <span class="text-muted small d-md-none">Unit Price</span>
                                <div>
                                    <span class="fw-semibold text-dark">$@item.Price.ToString("F2")</span>
                                </div>
                            </div>

                            <!-- Quantity Field Form -->
                            <div class="d-flex flex-row flex-md-column justify-content-between align-items-md-center w-100-mobile">
                                <span class="text-muted small d-md-none">Quantity</span>
                                <div>
                                    <form method="post" asp-controller="Cart" asp-action="UpdateQuantity" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="999" 
                                               class="form-control form-control-sm text-center fw-bold py-1 px-2 rounded-2" 
                                               style="width: 70px;" onchange="this.form.submit()">
                                    </form>
                                </div>
                            </div>

                            <!-- Subtotal display -->
                            <div class="d-flex flex-row flex-md-column justify-content-between align-items-md-end w-100-mobile">
                                <span class="text-muted small d-md-none">Subtotal</span>
                                <div>
                                    <span class="fw-bold text-primary">$@item.Subtotal.ToString("F2")</span>
                                </div>
                            </div>

                            <!-- Remove action form button -->
                            <div class="text-end w-100-mobile mt-2 mt-md-0">
                                <form method="post" asp-controller="Cart" asp-action="RemoveFromCart" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId">
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1.5 rounded-3 fw-semibold w-100-mobile">
                                        <i class="fas fa-trash-alt me-1"></i>Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Back navigation button -->
            <div class="mt-4">
                <a class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
        </div>

        <!-- Order Summary & Checkout -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4" style="position: sticky; top: 90px; z-index: 10;">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-receipt me-2 text-primary"></i>
                        <span>Order Summary</span>
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between border-bottom pb-2.5 mb-2.5 small">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold text-dark">$@Model.Total.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2.5 mb-2.5 small">
                        <span class="text-muted">Shipping</span>
                        <span class="fw-bold text-success">Free Delivery</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2.5 mb-2.5 small">
                        <span class="text-muted">Estimated Tax</span>
                        <span class="fw-bold text-dark">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between pt-3 mb-4 fs-5 fw-bold">
                        <span class="text-dark">Order Total</span>
                        <span class="text-primary">$@Model.Total.ToString("F2")</span>
                    </div>

                    <div class="d-grid">
                        <a class="btn btn-primary btn-lg py-3 fw-bold rounded-3 shadow" asp-controller="Checkout" asp-action="Index">
                            <i class="fas fa-lock me-2"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Trust / Guarantee Badge -->
            <div class="card border border-light bg-light rounded-3">
                <div class="card-body p-3 text-center">
                    <div class="d-flex flex-column gap-2 small text-muted">
                        <div><i class="fas fa-shield-alt text-success me-2 fs-5"></i>Secure SSL Checkout Encrypted</div>
                        <div><i class="fas fa-undo text-success me-2 fs-5"></i>30-Day Money Back Guarantee</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Empty Cart Placeholder State -->
    <div class="text-center py-5 shadow-sm rounded-3 bg-white border mt-3">
        <i class="fas fa-shopping-cart text-muted display-1 mb-3"></i>
        <h3 class="fw-bold text-dark">Your cart is empty</h3>
        <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">It looks like you haven't added any products to your shopping cart yet. Discover our premium catalog and find the best electronics today!</p>
        <a class="btn btn-primary btn-lg px-5 py-3 rounded-3 shadow mt-2" asp-controller="Home" asp-action="Index">
            <i class="fas fa-store me-2"></i>Start Shopping
        </a>
    </div>
}
