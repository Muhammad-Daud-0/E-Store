@model Product

@{
    ViewData["Title"] = Model.Name;
}

<!-- Dynamic Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none">
                <i class="fas fa-home me-1"></i>Shop
            </a>
        </li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-primary text-decoration-none">
                    @Model.Category.Name
                </a>
            </li>
        }
        <li class="breadcrumb-item active text-truncate" style="max-width: 250px;" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Product Details Layout -->
<div class="row g-5">
    <!-- Product Image Preview -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 1rem;">
            <div class="ratio ratio-1x1 bg-light d-flex align-items-center justify-content-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="object-fit-cover w-100 h-100" alt="@Model.Name"
                         onerror="this.outerHTML='<div class=\'d-flex align-items-center justify-content-center bg-light text-muted display-1\'><i class=\'fas fa-box\'></i></div>';" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light text-muted display-1">
                        <i class="fas fa-box"></i>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Product Purchasing Info -->
    <div class="col-lg-6 d-flex flex-column justify-content-between">
        <div>
            <!-- Category Tag -->
            @if (Model.Category != null)
            {
                <span class="badge bg-light text-primary border rounded-pill px-3 py-2 mb-3 fw-bold shadow-sm" style="font-size: 0.75rem; width: auto; height: auto; display: inline-block;">
                    <i class="fas fa-tag me-1"></i>@Model.Category.Name
                </span>
            }

            <!-- Title -->
            <h1 class="fw-extrabold text-dark mb-3 tracking-tight">@Model.Name</h1>

            <!-- Price & Stock Status Panel -->
            <div class="card border-0 bg-light p-4 mb-4 rounded-3 shadow-sm">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <p class="text-muted small mb-1 uppercase fw-semibold tracking-wider">Unit Price</p>
                        <h2 class="fw-bold text-primary mb-0" style="font-size: 2.5rem;">
                            $@Model.Price.ToString("F2")
                        </h2>
                    </div>
                    <div class="text-md-end">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2 shadow-sm fw-bold mb-1" style="width: auto; height: auto; display: inline-block; font-size: 0.8rem;">
                                <i class="fas fa-check-circle me-1"></i>In Stock
                            </span>
                            <p class="text-muted small mb-0 mt-1">
                                <i class="fas fa-boxes me-1"></i>@Model.StockQuantity units available
                            </p>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm fw-bold" style="width: auto; height: auto; display: inline-block; font-size: 0.8rem;">
                                <i class="fas fa-times-circle me-1"></i>Out of Stock
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- About Product Description -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark mb-2">Product Overview</h5>
                <p class="text-muted fs-6" style="line-height: 1.8;">
                    @Model.Description
                </p>
            </div>
        </div>

        <div>
            <!-- Add to Cart Form Controls -->
            @if (Model.StockQuantity > 0)
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="card border p-3.5 mb-4 bg-white rounded-3 shadow-sm">
                        <div class="row align-items-center g-3">
                            <div class="col-sm-4">
                                <label for="quantity" class="form-label small fw-bold text-muted mb-1 d-block">Quantity</label>
                                <input type="number" id="quantity" class="form-control form-control-lg rounded-3 py-2 fw-semibold text-center" 
                                       min="1" max="@Model.StockQuantity" value="1">
                            </div>
                            <div class="col-sm-8 pt-sm-4">
                                <button type="button" class="btn btn-primary btn-lg rounded-3 w-100 py-3 fw-bold shadow"
                                        onclick="addToCartAjaxWithQuantity(@Model.Id, 'quantity')">
                                    <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info d-flex align-items-center shadow-sm p-4 mb-4" role="alert">
                        <i class="fas fa-info-circle fs-4 text-primary me-3"></i>
                        <div>
                            <strong>Want to purchase?</strong> Please 
                            <a asp-controller="Account" asp-action="Login" class="alert-link text-decoration-underline">login to your account</a> 
                            to add items to your shopping cart.
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center shadow-sm p-4 mb-4" role="alert">
                    <i class="fas fa-exclamation-triangle fs-4 text-warning me-3"></i>
                    <div>
                        <strong>Unavailable:</strong> This product is currently out of stock. We are replenishing inventory rapidly.
                    </div>
                </div>
            }

            <!-- Trust Badges & Guarantee Policy -->
            <div class="card border-0 bg-light rounded-3 shadow-xs">
                <div class="card-body p-3">
                    <div class="row text-center g-3">
                        <div class="col-6 border-end">
                            <div class="text-primary mb-1"><i class="fas fa-shipping-fast fs-4"></i></div>
                            <h6 class="fw-bold text-dark mb-0 small">Free Shipping</h6>
                            <span class="text-muted small" style="font-size: 0.75rem;">On orders above $50</span>
                        </div>
                        <div class="col-6">
                            <div class="text-primary mb-1"><i class="fas fa-shield-alt fs-4"></i></div>
                            <h6 class="fw-bold text-dark mb-0 small">30-Day Returns</h6>
                            <span class="text-muted small" style="font-size: 0.75rem;">100% money back guarantee</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Action Button -->
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold">
                    <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
