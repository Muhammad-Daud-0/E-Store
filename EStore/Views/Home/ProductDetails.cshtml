@model Product

@{
    ViewData["Title"] = Model.Name;
}

<!-- Dynamic Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4 animate-fade-in-up">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--accent-1);">
                <i class="fas fa-home me-1"></i>Shop
            </a>
        </li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none" style="color: var(--accent-1);">
                    @Model.Category.Name
                </a>
            </li>
        }
        <li class="breadcrumb-item active text-truncate" style="max-width: 250px; color: var(--text-primary);" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Product Details Layout -->
<div class="row g-5">
    <!-- Product Image Preview -->
    <div class="col-lg-6 animate-fade-in-up delay-1">
        <div class="card border-0 overflow-hidden" style="border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);">
            <div class="ratio ratio-1x1 d-flex align-items-center justify-content-center" style="background: var(--bg-tertiary);">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="object-fit-cover w-100 h-100" alt="@Model.Name"
                         style="transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);"
                         onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"
                         onerror="this.outerHTML='<div class=\'d-flex align-items-center justify-content-center display-1\' style=\'background: var(--bg-tertiary); color: var(--text-muted);\'><i class=\'fas fa-box\'></i></div>';" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center display-1" style="background: var(--bg-tertiary); color: var(--text-muted);">
                        <i class="fas fa-box"></i>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Product Purchasing Info -->
    <div class="col-lg-6 d-flex flex-column justify-content-between animate-fade-in-up delay-2">
        <div>
            <!-- Category Tag -->
            @if (Model.Category != null)
            {
                <span class="badge rounded-pill px-3 py-2 mb-3 fw-bold" style="background: var(--accent-gradient); color: white; font-size: 0.75rem; display: inline-block;">
                    <i class="fas fa-tag me-1"></i>@Model.Category.Name
                </span>
            }

            <!-- Title -->
            <h1 class="fw-bold mb-3" style="color: var(--text-primary); letter-spacing: -0.03em;">@Model.Name</h1>

            <!-- Price & Stock Status Panel -->
            <div class="glass-card p-4 mb-4" style="box-shadow: var(--shadow-md);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <p class="small mb-1 fw-semibold text-uppercase" style="color: var(--text-muted); letter-spacing: 0.05em;">Unit Price</p>
                        <h2 class="fw-bold text-gradient mb-0" style="font-size: 2.5rem;">
                            $@Model.Price.ToString("F2")
                        </h2>
                    </div>
                    <div class="text-md-end">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="product-stock stock-in mb-1" style="font-size: 0.8rem; padding: 0.4rem 0.85rem;">
                                <i class="fas fa-check-circle me-1"></i>In Stock
                            </span>
                            <p class="small mb-0 mt-1" style="color: var(--text-muted);">
                                <i class="fas fa-boxes me-1"></i>@Model.StockQuantity units available
                            </p>
                        }
                        else
                        {
                            <span class="product-stock stock-out" style="font-size: 0.8rem; padding: 0.4rem 0.85rem;">
                                <i class="fas fa-times-circle me-1"></i>Out of Stock
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- About Product Description -->
            <div class="mb-4">
                <h5 class="fw-bold mb-2" style="color: var(--text-primary);">Product Overview</h5>
                <p style="color: var(--text-secondary); line-height: 1.8;">
                    @Model.Description
                </p>
            </div>
        </div>

        <div>
            <!-- Add to Cart Form Controls -->
            @if (Model.StockQuantity > 0)
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="card p-4 mb-4" style="border: 1px solid var(--border-color); border-radius: var(--radius-lg); background: var(--bg-card); box-shadow: var(--shadow-sm);">
                        <div class="row align-items-center g-3">
                            <div class="col-sm-4">
                                <label for="quantity" class="form-label small fw-bold d-block" style="color: var(--text-muted);">Quantity</label>
                                <input type="number" id="quantity" class="form-control form-control-lg py-2 fw-semibold text-center" 
                                       min="1" max="@Model.StockQuantity" value="1"
                                       style="border-radius: var(--radius-md);">
                            </div>
                            <div class="col-sm-8 pt-sm-4">
                                <button type="button" class="btn btn-primary btn-lg w-100 py-3 fw-bold"
                                        style="border-radius: var(--radius-lg); box-shadow: 0 8px 25px var(--accent-glow-strong);"
                                        onclick="addToCartAjaxWithQuantity(@Model.Id, 'quantity')">
                                    <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info d-flex align-items-center p-4 mb-4" role="alert" style="border-radius: var(--radius-lg);">
                        <i class="fas fa-info-circle fs-4 me-3" style="color: var(--accent-1);"></i>
                        <div>
                            <strong>Want to purchase?</strong> Please 
                            <a asp-controller="Account" asp-action="Login" class="alert-link text-decoration-underline">login to your account</a> 
                            to add items to your shopping cart.
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center p-4 mb-4" role="alert" style="border-radius: var(--radius-lg);">
                    <i class="fas fa-exclamation-triangle fs-4 me-3" style="color: var(--warning);"></i>
                    <div>
                        <strong>Unavailable:</strong> This product is currently out of stock. We are replenishing inventory rapidly.
                    </div>
                </div>
            }

            <!-- Trust Badges & Guarantee Policy -->
            <div class="card border-0" style="background: var(--bg-tertiary); border-radius: var(--radius-lg); border: 1px solid var(--border-color) !important;">
                <div class="card-body p-4">
                    <div class="row text-center g-3">
                        <div class="col-6" style="border-right: 1px solid var(--border-color);">
                            <div class="mb-2" style="color: var(--accent-1);"><i class="fas fa-shipping-fast fs-3"></i></div>
                            <h6 class="fw-bold mb-1 small" style="color: var(--text-primary);">Free Shipping</h6>
                            <span class="small" style="color: var(--text-muted); font-size: 0.75rem;">On orders above $50</span>
                        </div>
                        <div class="col-6">
                            <div class="mb-2" style="color: var(--accent-1);"><i class="fas fa-shield-alt fs-3"></i></div>
                            <h6 class="fw-bold mb-1 small" style="color: var(--text-primary);">30-Day Returns</h6>
                            <span class="small" style="color: var(--text-muted); font-size: 0.75rem;">100% money back guarantee</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Action Button -->
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold" style="border-radius: var(--radius-md);">
                    <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
