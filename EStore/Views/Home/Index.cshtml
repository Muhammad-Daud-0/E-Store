@model HomePageViewModel

@{
    ViewData["Title"] = "Product Catalog";
}

<!-- Premium Hero Section -->
<div class="hero-section text-center text-white py-5 px-4 mb-5 shadow"
     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 1.25rem;">
    <div class="py-4">
        <h1 class="display-4 fw-bold text-white mb-2 tracking-tight">
            <i class="fas fa-shopping-bag me-3"></i>Welcome to E-Store
        </h1>
        <p class="fs-5 opacity-90 mb-0">Discover premium high-tech gadgets and office equipment at unbeatable prices.</p>
    </div>
</div>

<!-- Authentication Warning Banner for Guests -->
@if (User.Identity?.IsAuthenticated == false)
{
    <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between align-items-md-center shadow-sm p-4 mb-4" role="alert">
        <div class="mb-3 mb-md-0">
            <h5 class="alert-heading fw-bold mb-1"><i class="fas fa-info-circle me-2 text-primary"></i>Experience the Best Shopping</h5>
            <p class="mb-0 text-muted small">Sign in to your account to add items to your cart, customize your orders, and proceed with a secure checkout.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary btn-sm px-4 py-2" asp-controller="Account" asp-action="Login">
                <i class="fas fa-sign-in-alt me-1"></i>Login
            </a>
            <a class="btn btn-outline-secondary btn-sm px-4 py-2" asp-controller="Account" asp-action="Register">
                <i class="fas fa-user-plus me-1"></i>Register
            </a>
        </div>
    </div>
}

<!-- Interactive Search & Navigation Controls -->
<div class="row g-3 align-items-center mb-4">
    <div class="col-md-8">
        <div class="position-relative">
            <input type="text" id="searchInput" class="form-control rounded-pill ps-4 pe-5 py-3 shadow-sm" 
                   placeholder="Search our catalog by name or description..." autocomplete="off">
            <i class="fas fa-search position-absolute text-muted" style="right: 1.5rem; top: 50%; transform: translateY(-50%); pointer-events: none;"></i>
        </div>
    </div>
    <div class="col-md-4 text-md-end text-muted small">
        <span id="resultsCount" class="fw-semibold">Showing all products</span>
    </div>
</div>

<!-- Category Selection Filter Buttons -->
@if (Model.Categories.Any())
{
    <div class="d-flex flex-wrap gap-2 mb-5">
        <a href="@Url.Action("Index", "Home")" class="btn btn-sm rounded-pill px-4 py-2 shadow-sm @(!Model.SelectedCategoryId.HasValue ? "btn-primary" : "btn-light border")">
            <i class="fas fa-th me-2"></i>All Products
        </a>
        @foreach (var category in Model.Categories.OrderBy(c => c.Name))
        {
            <a asp-action="Index" asp-route-categoryId="@category.Id"
               class="btn btn-sm rounded-pill px-4 py-2 shadow-sm @(Model.SelectedCategoryId == category.Id ? "btn-primary" : "btn-light border")">
                <i class="fas fa-tag me-2"></i>@category.Name
            </a>
        }
    </div>
}

<!-- Controls bar for sorting -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        @if (Model.SelectedCategoryId.HasValue)
        {
            var selectedCat = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId);
            if (selectedCat != null)
            {
                <h3 class="fw-bold text-dark mb-0">@selectedCat.Name</h3>
                <p class="text-muted small mb-0">@selectedCat.Description</p>
            }
        }
        else
        {
            <h3 class="fw-bold text-dark mb-0">Our Collection</h3>
        }
    </div>
    
    <!-- Sort Option Dropdown (Only on general catalog) -->
    @if (!Model.SelectedCategoryId.HasValue)
    {
        <div class="d-flex align-items-center gap-2">
            <label for="sortSelect" class="text-muted small fw-semibold mb-0 text-nowrap">Sort By:</label>
            <select id="sortSelect" class="form-select form-select-sm rounded-3 py-2 shadow-sm" style="min-width: 180px;"
                    onchange="window.location.href='@Url.Action("Index", "Home")?sort=' + this.value">
                @if (ViewData["CurrentSort"]?.ToString() == "name" || string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()))
                {
                    <option value="name" selected>Name (A-Z)</option>
                }
                else
                {
                    <option value="name">Name (A-Z)</option>
                }

                @if (ViewData["CurrentSort"]?.ToString() == "price-low")
                {
                    <option value="price-low" selected>Price (Low to High)</option>
                }
                else
                {
                    <option value="price-low">Price (Low to High)</option>
                }

                @if (ViewData["CurrentSort"]?.ToString() == "price-high")
                {
                    <option value="price-high" selected>Price (High to Low)</option>
                }
                else
                {
                    <option value="price-high">Price (High to Low)</option>
                }

                @if (ViewData["CurrentSort"]?.ToString() == "newest")
                {
                    <option value="newest" selected>Newest First</option>
                }
                else
                {
                    <option value="newest">Newest First</option>
                }
            </select>
        </div>
    }
</div>

<!-- Product Grid Catalog -->
@if (Model.Products.Any())
{
    @if (!Model.SelectedCategoryId.HasValue)
    {
        <!-- Standard Flat Catalog Layout -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="productsContainer">
            @foreach (var product in Model.Products)
            {
                <div class="col product-card-wrapper">
                    <div class="card h-100 product-card shadow-sm border-0 position-relative"
                         data-product-name="@product.Name" data-product-description="@product.Description">
                         
                         <!-- Product Image -->
                         <div class="ratio ratio-4x3 bg-light overflow-hidden rounded-top">
                             @if (!string.IsNullOrEmpty(product.ImageUrl))
                             {
                                 <img src="@product.ImageUrl" class="object-fit-cover" alt="@product.Name"
                                      onerror="this.outerHTML='<div class=\'d-flex align-items-center justify-content-center bg-light text-muted fs-2\'><i class=\'fas fa-box\'></i></div>';" />
                             }
                             else
                             {
                                 <div class="d-flex align-items-center justify-content-center bg-light text-muted fs-2">
                                     <i class="fas fa-box"></i>
                                 </div>
                             }
                         </div>
                         
                         <!-- Stock Status Indicator Badge -->
                         <div class="position-absolute" style="top: 12px; right: 12px; z-index: 10;">
                             @if (product.StockQuantity > 0)
                             {
                                 <span class="badge bg-success rounded-pill px-2.5 py-1.5 shadow-sm fw-bold" style="font-size: 0.7rem; border-radius: 20px; width: auto; height: auto;">
                                     <i class="fas fa-check-circle me-1"></i>In Stock
                                 </span>
                             }
                             else
                             {
                                 <span class="badge bg-danger rounded-pill px-2.5 py-1.5 shadow-sm fw-bold" style="font-size: 0.7rem; border-radius: 20px; width: auto; height: auto;">
                                     <i class="fas fa-times-circle me-1"></i>Out of Stock
                                 </span>
                             }
                         </div>
                         
                         <!-- Product Description Body -->
                         <div class="card-body d-flex flex-column p-3.5">
                             <h6 class="fw-bold text-dark mb-1 text-truncate" title="@product.Name">@product.Name</h6>
                             <p class="text-muted small mb-3 flex-grow-1" style="min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                 @product.Description
                             </p>
                             
                             <div class="mt-auto">
                                 <div class="fs-4 fw-bold text-primary mb-3">
                                     $@product.Price.ToString("F2")
                                 </div>
                                 <div class="d-flex gap-2">
                                     <a class="btn btn-outline-primary btn-sm flex-grow-1 py-2 fw-semibold" asp-action="ProductDetails" asp-route-id="@product.Id">
                                         <i class="fas fa-eye me-1"></i>View
                                     </a>
                                     @if (product.StockQuantity > 0 && User.Identity?.IsAuthenticated == true)
                                     {
                                         <button type="button" class="btn btn-success btn-sm px-3 py-2 fw-semibold" onclick="addToCartAjax(@product.Id)" title="Add to Cart">
                                             <i class="fas fa-cart-plus"></i>
                                         </button>
                                     }
                                 </div>
                             </div>
                         </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Category-Specific Structured Catalog -->
        var productsByCategory = Model.Products.GroupBy(p => p.Category?.Name ?? "Uncategorized");
        
        @foreach (var categoryGroup in productsByCategory)
        {
            var category = Model.Categories.FirstOrDefault(c => c.Name == categoryGroup.Key);
            <div class="category-section mb-5" data-category="@categoryGroup.Key">
                <!-- Products Grid -->
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                    @foreach (var product in categoryGroup.OrderBy(p => p.Name))
                    {
                        <div class="col product-card-wrapper">
                            <div class="card h-100 product-card shadow-sm border-0 position-relative"
                                 data-product-name="@product.Name" data-product-description="@product.Description">
                                 
                                 <!-- Product Image -->
                                 <div class="ratio ratio-4x3 bg-light overflow-hidden rounded-top">
                                     @if (!string.IsNullOrEmpty(product.ImageUrl))
                                     {
                                         <img src="@product.ImageUrl" class="object-fit-cover" alt="@product.Name"
                                              onerror="this.outerHTML='<div class=\'d-flex align-items-center justify-content-center bg-light text-muted fs-2\'><i class=\'fas fa-box\'></i></div>';" />
                                     }
                                     else
                                     {
                                         <div class="d-flex align-items-center justify-content-center bg-light text-muted fs-2">
                                             <i class="fas fa-box"></i>
                                         </div>
                                     }
                                 </div>
                                 
                                 <!-- Stock Status Indicator Badge -->
                                 <div class="position-absolute" style="top: 12px; right: 12px; z-index: 10;">
                                     @if (product.StockQuantity > 0)
                                     {
                                         <span class="badge bg-success rounded-pill px-2.5 py-1.5 shadow-sm fw-bold" style="font-size: 0.7rem; border-radius: 20px; width: auto; height: auto;">
                                             <i class="fas fa-check-circle me-1"></i>In Stock
                                         </span>
                                     }
                                     else
                                     {
                                         <span class="badge bg-danger rounded-pill px-2.5 py-1.5 shadow-sm fw-bold" style="font-size: 0.7rem; border-radius: 20px; width: auto; height: auto;">
                                             <i class="fas fa-times-circle me-1"></i>Out of Stock
                                         </span>
                                     }
                                 </div>
                                 
                                 <!-- Product Description Body -->
                                 <div class="card-body d-flex flex-column p-3.5">
                                     <h6 class="fw-bold text-dark mb-1 text-truncate" title="@product.Name">@product.Name</h6>
                                     <p class="text-muted small mb-3 flex-grow-1" style="min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                         @product.Description
                                     </p>
                                     
                                     <div class="mt-auto">
                                         <div class="fs-4 fw-bold text-primary mb-3">
                                             $@product.Price.ToString("F2")
                                         </div>
                                         <div class="d-flex gap-2">
                                             <a class="btn btn-outline-primary btn-sm flex-grow-1 py-2 fw-semibold" asp-action="ProductDetails" asp-route-id="@product.Id">
                                                 <i class="fas fa-eye me-1"></i>View
                                             </a>
                                             @if (product.StockQuantity > 0 && User.Identity?.IsAuthenticated == true)
                                             {
                                                 <button type="button" class="btn btn-success btn-sm px-3 py-2 fw-semibold" onclick="addToCartAjax(@product.Id)" title="Add to Cart">
                                                     <i class="fas fa-cart-plus"></i>
                                                 </button>
                                             }
                                         </div>
                                     </div>
                                 </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
}
else
{
    <div class="text-center py-5 shadow-sm rounded-3 bg-white border">
        <i class="fas fa-box-open text-muted display-1 mb-3"></i>
        <h4 class="fw-bold text-dark">No products available</h4>
        <p class="text-muted mb-0">Our product catalog is currently empty. Please check back later!</p>
    </div>
}

<!-- No Search Results Found Banner -->
<div id="noResults" class="text-center py-5 shadow-sm rounded-3 bg-white border" style="display: none;">
    <i class="fas fa-search text-muted display-2 mb-3"></i>
    <h4 class="fw-bold text-dark">No products match your search</h4>
    <p class="text-muted mb-0">Try typing a different keyword or browse through the categories above.</p>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const productWrappers = document.querySelectorAll('.product-card-wrapper');
            const categorySections = document.querySelectorAll('.category-section');
            const noResults = document.getElementById('noResults');
            const resultsCount = document.getElementById('resultsCount');

            searchInput.addEventListener('input', function (e) {
                const searchTerm = e.target.value.toLowerCase().trim();
                let visibleProducts = 0;

                // Filter standard flat product list items
                productWrappers.forEach(wrapper => {
                    const card = wrapper.querySelector('.product-card');
                    const productName = card.getAttribute('data-product-name').toLowerCase();
                    const productDescription = card.getAttribute('data-product-description').toLowerCase();

                    if (productName.includes(searchTerm) || productDescription.includes(searchTerm)) {
                        wrapper.style.display = 'block';
                        visibleProducts++;
                    } else {
                        wrapper.style.display = 'none';
                    }
                });

                // In case of category sections, show/hide sections based on child visibility
                if (categorySections.length > 0) {
                    categorySections.forEach(section => {
                        const innerCards = section.querySelectorAll('.product-card-wrapper');
                        let visibleInSection = 0;
                        
                        innerCards.forEach(wrapper => {
                            const card = wrapper.querySelector('.product-card');
                            const productName = card.getAttribute('data-product-name').toLowerCase();
                            const productDescription = card.getAttribute('data-product-description').toLowerCase();

                            if (productName.includes(searchTerm) || productDescription.includes(searchTerm)) {
                                wrapper.style.display = 'block';
                                visibleInSection++;
                                visibleProducts++; // Already incremented globally above, but let's make sure it's accurate
                            } else {
                                wrapper.style.display = 'none';
                            }
                        });

                        if (visibleInSection > 0) {
                            section.style.display = 'block';
                        } else {
                            section.style.display = 'none';
                        }
                    });
                    
                    // Re-calculate unique visible count since category-wise layout has parallel increment
                    const totalCards = document.querySelectorAll('.product-card');
                    let actualVisible = 0;
                    totalCards.forEach(c => {
                        const wrapper = c.closest('.product-card-wrapper');
                        if (wrapper && wrapper.style.display !== 'none') {
                            actualVisible++;
                        }
                    });
                    visibleProducts = actualVisible;
                }

                // Update count text labels
                if (searchTerm === '') {
                    resultsCount.textContent = 'Showing all products';
                } else {
                    resultsCount.textContent = `Found ${visibleProducts} product${visibleProducts !== 1 ? 's' : ''} matching "${searchTerm}"`;
                }

                // Show/hide zero-results banner
                if (visibleProducts === 0) {
                    noResults.style.display = 'block';
                    const container = document.getElementById('productsContainer');
                    if (container) container.style.display = 'none';
                } else {
                    noResults.style.display = 'none';
                    const container = document.getElementById('productsContainer');
                    if (container) container.style.display = 'flex';
                }
            });
        });
    </script>
}
