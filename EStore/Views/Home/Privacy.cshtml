@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Page Header -->
<div class="mb-4">
    <h1 style="color: #1f2937; margin-bottom: 0;">
        <i class="fas fa-shield-alt me-2" style="color: #667eea;"></i>Privacy Policy
    </h1>
    <p class="text-muted">Your privacy is important to us</p>
</div>

<!-- Content -->
<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <!-- Introduction -->
                <section class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>Introduction
                    </h5>
                    <p class="text-muted">
                        E-Store ("we", "our", or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website and use our services.
                    </p>
                </section>

                <!-- Information We Collect -->
                <section class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-database me-2" style="color: #667eea;"></i>Information We Collect
                    </h5>
                    <p class="text-muted">We may collect information about you in a variety of ways. The information we may collect on the site includes:</p>
                    <ul class="text-muted">
                        <li><strong>Personal Data:</strong> Email address, name, phone number, and other identifying information when you register or make a purchase</li>
                        <li><strong>Payment Information:</strong> Billing address, credit card details (processed securely)</li>
                        <li><strong>Usage Data:</strong> Information about how you interact with our website</li>
                        <li><strong>Device Information:</strong> IP address, browser type, operating system</li>
                    </ul>
                </section>

                <!-- How We Use Information -->
                <section class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-cog me-2" style="color: #667eea;"></i>How We Use Your Information
                    </h5>
                    <p class="text-muted">We use the information we collect to:</p>
                    <ul class="text-muted">
                        <li>Process your transactions and send related information</li>
                        <li>Email you regarding your order</li>
                        <li>Fulfill and manage your orders</li>
                        <li>Generate a personal profile about you</li>
                        <li>Increase the efficiency and operation of our site</li>
                        <li>Monitor and analyze usage and trends</li>
                    </ul>
                </section>

                <!-- Security -->
                <section class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-lock me-2" style="color: #667eea;"></i>Security
                    </h5>
                    <p class="text-muted">
                        We use administrative, technical, and physical security measures to protect your personal information. However, perfect security does not exist on the Internet. We encourage you to use strong passwords and practice safe internet habits.
                    </p>
                </section>

                <!-- Cookies -->
                <section class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-cookie me-2" style="color: #667eea;"></i>Cookies
                    </h5>
                    <p class="text-muted">
                        We use cookies to enhance your experience on our website. Cookies are small files placed on your device that allow us to recognize you and remember your preferences. You can choose to disable cookies through your browser settings, but this may affect your experience.
                    </p>
                </section>

                <!-- Contact Information -->
                <section class="mb-0">
                    <div class="alert alert-info border-0">
                        <h6 class="mb-2">
                            <i class="fas fa-envelope me-2"></i>Contact Us
                        </h6>
                        <p class="mb-0 text-muted">
                            If you have questions about this Privacy Policy, please contact us at <strong>privacy@estore.com</strong> or call <strong>1-800-ESTORE</strong>.
                        </p>
                    </div>
                </section>
            </div>
        </div>

        <!-- Last Updated -->
        <div class="text-center text-muted small mt-4">
            <p>Last updated: May 26, 2026</p>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Links -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6 class="card-title fw-bold mb-3">
                    <i class="fas fa-link me-2" style="color: #667eea;"></i>Quick Links
                </h6>
                <ul class="list-unstyled small">
                    <li><a href="/" class="text-primary text-decoration-none">Home</a></li>
                    <li><a href="/Home/Index" class="text-primary text-decoration-none">Shop</a></li>
                    <li><a href="/Cart" class="text-primary text-decoration-none">Cart</a></li>
                    <li><a href="/Account/Login" class="text-primary text-decoration-none">Account</a></li>
                </ul>
            </div>
        </div>

        <!-- Company Info -->
        <div class="card border-0 bg-light">
            <div class="card-body">
                <h6 class="card-title fw-bold mb-3">
                    <i class="fas fa-store me-2" style="color: #667eea;"></i>About E-Store
                </h6>
                <p class="small text-muted">
                    E-Store is a modern e-commerce platform dedicated to providing quality products and excellent customer service. Your privacy and security are our top priorities.
                </p>
            </div>
        </div>
    </div>
</div>
