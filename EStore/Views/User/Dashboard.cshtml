@model UserDashboardViewModel

@{
    ViewData["Title"] = "My Account";
}

<!-- Premium Dashboard Header -->
<div class="dashboard-header py-5 px-4 mb-4 shadow"
     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 1.25rem;">
    <div class="row align-items-center g-3">
        <div class="col-md-9 text-center text-md-start text-white">
            <h1 class="display-5 fw-bold text-white mb-1">
                <i class="fas fa-user-circle me-2"></i>My Dashboard
            </h1>
            <p class="fs-6 opacity-80 mb-0">Manage your shipping address, order fulfillment status, and profile information.</p>
        </div>
        <div class="col-md-3 text-center text-md-end">
            <div class="d-inline-block bg-white bg-opacity-10 backdrop-blur border border-white border-opacity-10 py-3 px-4 rounded-3 text-white">
                <span class="small opacity-75 uppercase fw-bold tracking-wider d-block mb-1">Total Orders</span>
                <h2 class="fw-bold mb-0 text-white">@Model.Orders.Count()</h2>
            </div>
        </div>
    </div>
</div>

<!-- Alert Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show p-3 shadow-xs rounded-3" role="alert">
        <i class="fas fa-check-circle me-2 text-success"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show p-3 shadow-xs rounded-3" role="alert">
        <i class="fas fa-exclamation-circle me-2 text-danger"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-5 text-start">
    <!-- Account Information Card -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-light border-bottom p-3">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                    <i class="fas fa-id-card me-2 text-primary"></i>Profile Details
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-3.5 pb-3 border-bottom">
                    <span class="text-muted small uppercase fw-bold tracking-wider d-block mb-1">Email Address</span>
                    <span class="fw-semibold text-dark"><i class="fas fa-envelope me-2 text-primary"></i>@Model.User?.Email</span>
                </div>
                <div class="mb-3.5 pb-3 border-bottom">
                    <span class="text-muted small uppercase fw-bold tracking-wider d-block mb-1">System User ID</span>
                    <code class="font-monospace fw-semibold text-dark fs-7 bg-light px-2 py-1 rounded">@Model.User?.Id</code>
                </div>
                <div class="mb-0">
                    <span class="text-muted small uppercase fw-bold tracking-wider d-block mb-1.5">Account Status</span>
                    <span class="badge bg-success rounded-pill px-2.5 py-1.5 shadow-sm fw-bold" style="font-size: 0.75rem; width: auto; height: auto; display: inline-block;">
                        <i class="fas fa-check-circle me-1"></i>Active Account
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Stats Card -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-light border-bottom p-3">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                    <i class="fas fa-chart-bar me-2 text-primary"></i>Shopping Statistics
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 text-center">
                    <div class="col-6 border-end border-bottom pb-3">
                        <span class="text-muted small uppercase fw-semibold tracking-wider d-block mb-1">Total Spent</span>
                        <h4 class="fw-bold text-primary mb-0">$@Model.Orders.Where(o => o.OrderStatus == "Delivered").Sum(o => o.TotalPrice).ToString("F2")</h4>
                    </div>
                    <div class="col-6 border-bottom pb-3">
                        <span class="text-muted small uppercase fw-semibold tracking-wider d-block mb-1">Items Bought</span>
                        <h4 class="fw-bold text-primary mb-0">@Model.Orders.Where(o => o.OrderStatus == "Delivered").Sum(o => o.OrderItems.Sum(oi => oi.Quantity))</h4>
                    </div>
                    <div class="col-6 border-end pt-2">
                        <span class="text-muted small uppercase fw-semibold tracking-wider d-block mb-1">Pending Orders</span>
                        <h4 class="fw-bold text-warning mb-0">@Model.Orders.Count(o => o.OrderStatus.ToLower() == "pending")</h4>
                    </div>
                    <div class="col-6 pt-2">
                        <span class="text-muted small uppercase fw-semibold tracking-wider d-block mb-1">Delivered Orders</span>
                        <h4 class="fw-bold text-success mb-0">@Model.Orders.Count(o => o.OrderStatus.ToLower() == "delivered")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Order History Listing -->
<div class="text-start">
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">
            <i class="fas fa-box me-2 text-primary"></i>Your Purchase History
        </h3>
        <p class="text-muted small mb-0">Expand each order to view complete item summaries and shipping progress</p>
    </div>

    @if (Model.Orders.Any())
    {
        <div class="row g-3">
            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
            {
                <div class="col-12">
                    <div class="card border shadow-sm rounded-3 overflow-hidden">
                        <!-- Accordion Order Header Toggle -->
                        <div class="p-3 bg-light collapsed border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" 
                             data-bs-toggle="collapse" data-bs-target="#order-collapse-@order.Id"
                             aria-expanded="false" aria-controls="order-collapse-@order.Id" style="cursor: pointer; transition: background-color 0.2s;">
                            
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Order #@order.Id</h6>
                                <span class="text-muted small"><i class="fas fa-calendar-alt me-1 text-primary"></i>@order.OrderDate.ToString("MMMM dd, yyyy h:mm tt")</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3.5">
                                @{
                                    var statusClass = order.OrderStatus.ToLower() switch
                                    {
                                        "pending" => "bg-warning text-dark",
                                        "processing" => "bg-primary text-white",
                                        "shipped" => "bg-info text-white",
                                        "delivered" => "bg-success text-white",
                                        "cancelled" => "bg-danger text-white",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge rounded-pill px-3 py-2 fw-bold @statusClass" style="font-size: 0.75rem; width: auto; height: auto; display: inline-block;">
                                    <i class="fas fa-info-circle me-1"></i>@order.OrderStatus
                                </span>

                                <div class="text-md-end ms-2">
                                    <span class="text-muted small d-block" style="font-size: 0.7rem;">Order Total</span>
                                    <strong class="text-primary fs-5">$@order.TotalPrice.ToString("F2")</strong>
                                </div>
                                
                                <i class="fas fa-chevron-down text-muted transition-chevron ms-2"></i>
                            </div>
                        </div>

                        <!-- Accordion Order Details Body -->
                        <div class="collapse" id="order-collapse-@order.Id">
                            <div class="card-body p-4 bg-white">
                                <!-- Order Items List -->
                                <div class="border rounded-3 overflow-hidden mb-4">
                                    <div class="bg-light px-3 py-2 border-bottom">
                                        <span class="fw-bold text-dark small"><i class="fas fa-shopping-basket me-2 text-primary"></i>Items in this Order</span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 small">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3 py-2">Product Name</th>
                                                    <th class="text-end py-2">Unit Price</th>
                                                    <th class="text-center py-2">Quantity</th>
                                                    <th class="text-end pe-3 py-2">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-semibold text-dark">@item.ProductName</td>
                                                        <td class="text-end text-muted">$@item.UnitPrice.ToString("F2")</td>
                                                        <td class="text-center fw-semibold">@item.Quantity</td>
                                                        <td class="text-end pe-3 fw-bold text-primary">$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Shipping Address Details -->
                                <div class="border rounded-3 p-3.5 mb-4 bg-light">
                                    <h6 class="fw-bold text-dark mb-2.5"><i class="fas fa-truck me-2 text-primary"></i>Shipping Details</h6>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-sm-6"><strong>Receiver Name:</strong> @order.CustomerName</div>
                                        <div class="col-sm-6"><strong>Contact Phone:</strong> @order.PhoneNumber</div>
                                        <div class="col-sm-6"><strong>Destination City:</strong> @order.City</div>
                                        <div class="col-sm-6"><strong>Delivery Address:</strong> @order.ShippingAddress</div>
                                    </div>
                                </div>

                                <!-- Progress Fulfillment Tracker -->
                                <div>
                                    <h6 class="fw-bold text-dark mb-3"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Delivery Fulfillment Status</h6>
                                    @if (order.OrderStatus == "Cancelled")
                                    {
                                        <div class="d-flex align-items-center gap-3 p-3 rounded border border-danger-subtle bg-danger-subtle text-danger" style="background-color: #fee2e2; border-color: #fecaca; color: #991b1b;">
                                            <i class="fas fa-times-circle fs-3 text-danger"></i>
                                            <div>
                                                <p class="fw-bold mb-0">Fulfillment Cancelled</p>
                                                <p class="small mb-0 opacity-80">This order was cancelled. Items have been returned to warehouse inventory.</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row text-center g-2 position-relative pt-2">
                                            @{
                                                var statuses = new[] { "Pending", "Processing", "Shipped", "Delivered" };
                                                var currentStatusIndex = Array.IndexOf(statuses, order.OrderStatus);
                                            }
                                            @for (int i = 0; i < statuses.Length; i++)
                                            {
                                                <div class="col-3">
                                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle text-white shadow-xs mb-2"
                                                         style="width: 36px; height: 36px; background: @(i <= currentStatusIndex ? "linear-gradient(135deg, #667eea 0%, #764ba2 100%)" : "#e5e7eb");">
                                                        @if (i <= currentStatusIndex)
                                                        {
                                                            <i class="fas fa-check fs-8"></i>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold fs-7">@(i + 1)</span>
                                                        }
                                                    </div>
                                                    <p class="small mb-0 fw-bold @(i <= currentStatusIndex ? "text-dark" : "text-muted")" style="font-size: 0.8rem;">@statuses[i]</p>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Cancellation Button (Only visible for Pending status) -->
                                    @if (order.OrderStatus == "Pending")
                                    {
                                        <div class="mt-4 pt-3 border-top text-end">
                                            <form method="post" asp-controller="User" asp-action="CancelOrder"
                                                  onsubmit="return confirm('Are you sure you want to cancel this order? This will restore stock in the inventory.');"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-outline-danger px-4 py-2 rounded-3 fw-semibold">
                                                    <i class="fas fa-times-circle me-1"></i>Cancel Order
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty Orders State -->
        <div class="text-center py-5 shadow-sm rounded-3 bg-white border">
            <i class="fas fa-box-open text-muted display-1 mb-3"></i>
            <h4 class="fw-bold text-dark">No orders yet</h4>
            <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">You have not placed any orders yet. Discover our latest catalog of high-tech gear and shop today!</p>
            <a class="btn btn-primary btn-lg px-5 py-3 rounded-3 shadow mt-2" asp-controller="Home" asp-action="Index">
                <i class="fas fa-store me-2"></i>Start Shopping
            </a>
        </div>
    }
</div>

@section Scripts {
    <style>
        .order-card .transition-chevron {
            transition: transform 0.3s ease;
        }
        .order-header:not(.collapsed) .transition-chevron {
            transform: rotate(180deg);
        }
    </style>
}