@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<!-- Checkout Header -->
<div class="mb-4">
    <h1 class="fw-bold text-dark mb-0">
        <i class="fas fa-credit-card text-primary me-2"></i>Checkout
    </h1>
    <p class="text-muted small mb-0">Provide your shipping address and billing details to complete your order</p>
</div>

<!-- Checkout Container -->
<div class="row g-4">
    <!-- Main Checkout Form -->
    <div class="col-lg-8">
        <!-- Backend transaction validation errors -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm p-3 mb-4 small fw-semibold" role="alert"></div>

        <form method="post" asp-controller="Checkout" asp-action="ProcessCheckout">
            @Html.AntiForgeryToken()

            <!-- Order Review Section -->
            <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-list me-2 text-primary"></i>Order Review
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Product</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end pe-3">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cart?.Items != null)
                                {
                                    @foreach (var item in Model.Cart.Items)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark">@item.ProductName</td>
                                            <td class="text-end text-muted">$@item.Price.ToString("F2")</td>
                                            <td class="text-end fw-semibold">@item.Quantity</td>
                                            <td class="text-end pe-3 fw-bold text-primary">$@item.Subtotal.ToString("F2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Shipping Contact Fields Section -->
            <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-shipping-fast me-2 text-primary"></i>Shipping Information
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-bold text-muted mb-1">Full Name</label>
                            <input asp-for="CustomerName" class="form-control rounded-3 py-2" placeholder="John Doe" required />
                            <span asp-validation-for="CustomerName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Email Address -->
                        <div class="col-md-6">
                            <label asp-for="CustomerEmail" class="form-label small fw-bold text-muted mb-1">Email Address</label>
                            <input asp-for="CustomerEmail" class="form-control rounded-3 py-2 bg-light" readonly />
                            <span asp-validation-for="CustomerEmail" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Shipping Address -->
                        <div class="col-12">
                            <label asp-for="ShippingAddress" class="form-label small fw-bold text-muted mb-1">Shipping Address</label>
                            <input asp-for="ShippingAddress" class="form-control rounded-3 py-2" placeholder="123 Main St, Apartment or Suite" required />
                            <span asp-validation-for="ShippingAddress" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-bold text-muted mb-1">City</label>
                            <input asp-for="City" class="form-control rounded-3 py-2" placeholder="Tech City" required />
                            <span asp-validation-for="City" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold text-muted mb-1">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+1 (555) 000-0000" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Simulation Panel -->
            <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-credit-card me-2 text-primary"></i>Simulated Payment Method
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="form-check d-flex align-items-center gap-2">
                        <input class="form-check-input mt-0" type="radio" name="paymentMethod" id="creditCard" value="credit-card" checked>
                        <label class="form-check-label small" for="creditCard">
                            <strong class="text-dark">Credit or Debit Card</strong>
                            <span class="text-muted d-block small mt-0.5">Simulate payment using Visa, Mastercard, or AMEX</span>
                        </label>
                    </div>
                    <hr class="my-4">
                    <div class="alert alert-warning d-flex align-items-center mb-0 p-3 shadow-xs" role="alert">
                        <i class="fas fa-vial fs-5 text-warning me-2.5"></i>
                        <div class="small fw-semibold">This is a demo store checkout simulation. No actual credit card billing will be processed.</div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2 d-sm-flex">
                <a class="btn btn-outline-secondary px-4 py-2.5 rounded-3 fw-semibold shadow-xs" asp-controller="Cart" asp-action="Index">
                    <i class="fas fa-arrow-left me-2"></i>Back to Cart
                </a>
                <button type="submit" class="btn btn-primary btn-lg flex-grow-1 py-3 fw-bold rounded-3 shadow">
                    <i class="fas fa-check-circle me-2"></i>Complete Place Order
                </button>
            </div>
        </form>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4" style="position: sticky; top: 90px; z-index: 10;">
            <div class="card-header bg-light border-bottom p-3">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                    <i class="fas fa-receipt me-2 text-primary"></i>Order Summary
                </h6>
            </div>
            <div class="card-body p-4">
                <!-- Items Count -->
                <div class="d-flex justify-content-between border-bottom pb-2.5 mb-2.5 small">
                    <span class="text-muted">Subtotal Items (@(Model.Cart?.Items?.Sum(i => i.Quantity) ?? 0))</span>
                    <span class="fw-bold text-dark">$@(Model.Cart?.Total.ToString("F2") ?? "0.00")</span>
                </div>

                <!-- Shipping -->
                <div class="d-flex justify-content-between border-bottom pb-2.5 mb-2.5 small">
                    <span class="text-muted">Shipping</span>
                    <span class="fw-bold text-success">Free Delivery</span>
                </div>

                <!-- Tax -->
                <div class="d-flex justify-content-between border-bottom pb-2.5 mb-2.5 small">
                    <span class="text-muted">Estimated Tax</span>
                    <span class="fw-bold text-dark">$0.00</span>
                </div>

                <!-- Total -->
                <div class="d-flex justify-content-between pt-3 mb-4 fs-5 fw-bold">
                    <span class="text-dark">Total Amount</span>
                    <span class="text-primary">$@(Model.Cart?.Total.ToString("F2") ?? "0.00")</span>
                </div>

                <!-- Protected Secure Trust Badges -->
                <div class="card border-0 bg-light rounded-3 shadow-xs">
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-2 small text-muted">
                            <div><i class="fas fa-shield-alt text-success me-2 fs-5"></i>Secure checkout server</div>
                            <div><i class="fas fa-lock text-success me-2 fs-5"></i>256-bit SSL encrypted connection</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
