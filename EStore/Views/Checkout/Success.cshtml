@model OrderConfirmationViewModel

@{
    ViewData["Title"] = "Order Confirmed";
}

<!-- Success Container -->
<div class="text-center py-5">
    <!-- Animated Success Tick Icon -->
    <div class="success-checkmark d-flex align-items-center justify-content-center rounded-circle mx-auto mb-4"
         style="width: 100px; height: 100px; background: var(--accent-gradient); box-shadow: 0 12px 35px var(--accent-glow-strong);">
        <i class="fas fa-check fs-1 text-white"></i>
    </div>

    <!-- Success Headlines -->
    <h1 class="fw-bold mb-2" style="color: var(--text-primary);">Order Confirmed!</h1>
    <p class="fs-5 mb-5" style="max-width: 600px; margin: 0 auto; color: var(--text-secondary);">
        Thank you for your purchase, <strong style="color: var(--text-primary);">@Model.CustomerName</strong>. Your order has been successfully processed and is now being prepared.
    </p>

    <div class="row justify-content-center g-4 text-start">
        <!-- Order Overview Card -->
        <div class="col-lg-5 col-md-6 animate-fade-in-up">
            <div class="card border-0 h-100 overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color) !important; box-shadow: var(--shadow-md); border-radius: var(--radius-lg);">
                <!-- Gradient top bar -->
                <div style="height: 4px; background: var(--accent-gradient);"></div>
                <div class="card-header p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-receipt" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Order Summary
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Order ID:</span>
                        <strong style="color: var(--text-primary);">#@Model.OrderId</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Order Date:</span>
                        <span style="color: var(--text-primary);">@Model.OrderDate.ToString("MMMM dd, yyyy h:mm tt")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Customer Name:</span>
                        <span style="color: var(--text-primary);">@Model.CustomerName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Ship-to City:</span>
                        <span style="color: var(--text-primary);">@Model.City</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted);">Shipping Address:</span>
                        <span class="text-end" style="max-width: 200px; color: var(--text-primary);">@Model.ShippingAddress</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2 fs-5 fw-bold">
                        <span style="color: var(--text-primary);">Total Paid:</span>
                        <span class="text-gradient">$@Model.TotalPrice.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ordered Items Card -->
        <div class="col-lg-5 col-md-6 animate-fade-in-up delay-1">
            <div class="card border-0 h-100 overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color) !important; box-shadow: var(--shadow-md); border-radius: var(--radius-lg);">
                <!-- Gradient top bar -->
                <div style="height: 4px; background: var(--accent-gradient);"></div>
                <div class="card-header p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-shopping-basket" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Ordered Items
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 310px; overflow-y: auto;">
                        <table class="table align-middle mb-0 small">
                            <thead class="sticky-top">
                                <tr>
                                    <th class="ps-3 py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Item</th>
                                    <th class="text-center py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Qty</th>
                                    <th class="text-end pe-3 py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold text-truncate" style="max-width: 150px; color: var(--text-primary); border-bottom: 1px solid var(--border-color);">@item.ProductName</td>
                                        <td class="text-center fw-semibold" style="color: var(--text-muted); border-bottom: 1px solid var(--border-color);">@item.Quantity</td>
                                        <td class="text-end pe-3 fw-bold text-gradient" style="border-bottom: 1px solid var(--border-color);">$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Tracking Notice Banner -->
    <div class="row justify-content-center mt-5 animate-fade-in-up delay-2">
        <div class="col-md-10 col-lg-8">
            <div class="d-flex align-items-center p-3 text-start" role="alert" style="background: var(--accent-glow); border: 1px solid var(--accent-1); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
                <span class="d-inline-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--accent-gradient);">
                    <i class="fas fa-info-circle text-white"></i>
                </span>
                <div class="small fw-semibold" style="color: var(--text-primary);">
                    Your order status is currently set to <strong class="text-gradient">Pending</strong>. You can monitor the fulfillment progress, view updates, or cancel the order within your account dashboard.
                </div>
            </div>
        </div>
    </div>

    <!-- Action Navigation Buttons -->
    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4 animate-fade-in-up delay-3">
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary btn-lg px-4 py-3 fw-bold" asp-controller="Admin" asp-action="Dashboard" style="border-radius: var(--radius-md); box-shadow: 0 8px 25px var(--accent-glow);">
                <i class="fas fa-cog me-2"></i>Go to Admin Dashboard
            </a>
        }
        else
        {
            <a class="btn btn-primary btn-lg px-4 py-3 fw-bold" asp-controller="User" asp-action="Dashboard" style="border-radius: var(--radius-md); box-shadow: 0 8px 25px var(--accent-glow);">
                <i class="fas fa-box me-2"></i>View My Orders
            </a>
        }
        <a class="btn btn-outline-secondary btn-lg px-4 py-3 fw-semibold" asp-controller="Home" asp-action="Index" style="border-radius: var(--radius-md);">
            <i class="fas fa-store me-2"></i>Continue Shopping
        </a>
    </div>
</div>
