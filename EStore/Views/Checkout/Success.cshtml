@model OrderConfirmationViewModel

@{
    ViewData["Title"] = "Order Confirmed";
}

<!-- Success Container -->
<div class="text-center py-5">
    <!-- Animated Success Tick Icon -->
    <div class="d-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow mx-auto mb-4 scale-in" 
         style="width: 90px; height: 90px; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
        <i class="fas fa-check fs-1"></i>
    </div>

    <!-- Success Headlines -->
    <h1 class="fw-bold text-dark mb-2">Order Confirmed!</h1>
    <p class="text-muted fs-5 mb-5" style="max-width: 600px; margin: 0 auto;">
        Thank you for your purchase, <strong>@Model.CustomerName</strong>. Your order has been successfully processed and is now being prepared.
    </p>

    <div class="row justify-content-center g-4 text-start">
        <!-- Order Overview Card -->
        <div class="col-lg-5 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-receipt me-2 text-primary"></i>Order Summary
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted">Order ID:</span>
                        <strong class="text-dark">#@Model.OrderId</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted">Order Date:</span>
                        <span class="text-dark">@Model.OrderDate.ToString("MMMM dd, yyyy h:mm tt")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted">Customer Name:</span>
                        <span class="text-dark">@Model.CustomerName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted">Ship-to City:</span>
                        <span class="text-dark">@Model.City</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span class="text-muted">Shipping Address:</span>
                        <span class="text-dark text-end" style="max-width: 200px;">@Model.ShippingAddress</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2 fs-5 fw-bold text-primary">
                        <span>Total Paid:</span>
                        <span>$@Model.TotalPrice.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ordered Items Card -->
        <div class="col-lg-5 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-light border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="fas fa-shopping-basket me-2 text-primary"></i>Ordered Items
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 310px; overflow-y: auto;">
                        <table class="table align-middle mb-0 small">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="ps-3 py-2">Item</th>
                                    <th class="text-center py-2">Qty</th>
                                    <th class="text-end pe-3 py-2">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold text-dark text-truncate" style="max-width: 150px;">@item.ProductName</td>
                                        <td class="text-center fw-semibold text-muted">@item.Quantity</td>
                                        <td class="text-end pe-3 fw-bold text-primary">$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Tracking Notice Banner -->
    <div class="row justify-content-center mt-5">
        <div class="col-md-10 col-lg-8">
            <div class="alert alert-success d-flex align-items-center p-3 shadow-xs rounded-3 border-0 text-start" role="alert">
                <i class="fas fa-info-circle fs-4 text-success me-3"></i>
                <div class="small fw-semibold text-success">
                    Your order status is currently set to <strong>Pending</strong>. You can monitor the fulfillment progress, view updates, or cancel the order within your account dashboard.
                </div>
            </div>
        </div>
    </div>

    <!-- Action Navigation Buttons -->
    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary btn-lg px-4 py-3 rounded-3 fw-bold shadow" asp-controller="Admin" asp-action="Dashboard">
                <i class="fas fa-cog me-2"></i>Go to Admin Dashboard
            </a>
        }
        else
        {
            <a class="btn btn-primary btn-lg px-4 py-3 rounded-3 fw-bold shadow" asp-controller="User" asp-action="Dashboard">
                <i class="fas fa-box me-2"></i>View My Orders
            </a>
        }
        <a class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-3 fw-semibold" asp-controller="Home" asp-action="Index">
            <i class="fas fa-store me-2"></i>Continue Shopping
        </a>
    </div>
</div>

<style>
    .scale-in {
        animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>
