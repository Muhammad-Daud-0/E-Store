@model Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="dashboard-header py-5 px-4 mb-4">
    <h1 class="fw-bold text-white mb-1">
        <i class="fas fa-plus me-2"></i>Add New Category
    </h1>
    <p class="mb-0 mt-2" style="color: rgba(255,255,255,0.7);">Create a new product category</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card rounded-3 overflow-hidden" style="border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
            <div class="card-body p-4">
                <form method="post" asp-action="AddCategory">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold" style="color: var(--text-primary);">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Electronics, Clothing, Books" />
                        <span asp-validation-for="Name" class="small" style="color: var(--danger);"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold" style="color: var(--text-primary);">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe this category..."></textarea>
                        <span asp-validation-for="Description" class="small" style="color: var(--danger);"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IconUrl" class="form-label fw-bold" style="color: var(--text-primary);">Icon URL</label>
                        <input asp-for="IconUrl" class="form-control" placeholder="https://example.com/icon.png" />
                        <small class="d-block mt-1" style="color: var(--text-muted);">
                            <i class="fas fa-info-circle me-1"></i>
                            Provide a URL to an icon image for this category
                        </small>
                        <span asp-validation-for="IconUrl" class="small" style="color: var(--danger);"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary py-2 px-4 fw-bold">
                            <i class="fas fa-save me-2"></i>Create Category
                        </button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary py-2 px-4 fw-semibold">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
