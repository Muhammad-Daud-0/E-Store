@model Category

@{
    ViewData["Title"] = "Edit Category";
}

<!-- Page Header -->
<div class="mb-4 text-start">
    <h1 class="fw-bold mb-0" style="color: var(--text-primary);">
        <i class="fas fa-edit me-2" style="color: var(--accent-1);"></i>Edit Category
    </h1>
    <p class="small mb-0" style="color: var(--text-muted);">Update store category name, grouping icon, and catalog overview description</p>
</div>

<div class="row text-start g-4">
    <div class="col-lg-8">
        <div class="card rounded-3 overflow-hidden" style="border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
            <div class="card-header" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); padding: 1rem 1.25rem;">
                <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                    <i class="fas fa-folder me-2" style="color: var(--accent-1);"></i>Category Details
                </h6>
            </div>
            <div class="card-body p-4" style="background: var(--bg-card);">
                <form method="post" asp-action="EditCategory">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-3 mb-4 small fw-semibold" role="alert"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <!-- Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-bold mb-1" style="color: var(--text-muted);">Category Name</label>
                        <input asp-for="Name" class="form-control rounded-3 py-2" placeholder="e.g. Smart Electronics" required />
                        <span asp-validation-for="Name" class="small mt-1 d-block" style="color: var(--danger);"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-bold mb-1" style="color: var(--text-muted);">Category Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Briefly summarize the product collections within this category..."></textarea>
                        <span asp-validation-for="Description" class="small mt-1 d-block" style="color: var(--danger);"></span>
                    </div>

                    <!-- Icon URL -->
                    <div class="mb-3">
                        <label asp-for="IconUrl" class="form-label small fw-bold mb-1" style="color: var(--text-muted);">Grouping Icon URL</label>
                        <input asp-for="IconUrl" class="form-control rounded-3 py-2" placeholder="https://example.com/icon.jpg" />
                        <span asp-validation-for="IconUrl" class="small mt-1 d-block" style="color: var(--danger);"></span>
                        <small class="form-text small mt-1" style="color: var(--text-muted);">
                            <i class="fas fa-info-circle me-1" style="color: var(--accent-1);"></i>Provide a direct link to an icon or illustrative thumbnail photo.
                        </small>
                    </div>

                    <!-- Preview -->
                    @if (!string.IsNullOrEmpty(Model.IconUrl))
                    {
                        <div class="mb-4">
                            <span class="small fw-bold d-block mb-2" style="color: var(--text-muted);">Category Icon Preview</span>
                            <img src="@Model.IconUrl" alt="@Model.Name" class="rounded-3" style="max-height: 100px; object-fit: cover; border: 1px solid var(--border-color);" onerror="this.style.display='none'" />
                        </div>
                    }

                    <!-- Buttons -->
                    <div class="d-grid gap-2 d-sm-flex">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 py-3 fw-bold rounded-3">
                            <i class="fas fa-save me-2"></i>Update Category Details
                        </button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-3 fw-semibold">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
