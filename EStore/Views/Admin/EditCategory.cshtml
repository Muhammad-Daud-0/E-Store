@model Category

@{
    ViewData["Title"] = "Edit Category";
}

<!-- Page Header -->
<div class="mb-4 text-start">
    <h1 class="fw-bold text-dark mb-0">
        <i class="fas fa-edit text-primary me-2"></i>Edit Category
    </h1>
    <p class="text-muted small mb-0">Update store category name, grouping icon, and catalog overview description</p>
</div>

<div class="row text-start g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-header bg-light border-bottom p-3">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                    <i class="fas fa-folder me-2 text-primary"></i>Category Details
                </h6>
            </div>
            <div class="card-body p-4 bg-white">
                <form method="post" asp-action="EditCategory">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm p-3 mb-4 small fw-semibold" role="alert"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <!-- Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-bold text-muted mb-1">Category Name</label>
                        <input asp-for="Name" class="form-control rounded-3 py-2" placeholder="e.g. Smart Electronics" required />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-bold text-muted mb-1">Category Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Briefly summarize the product collections within this category..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Icon URL -->
                    <div class="mb-3">
                        <label asp-for="IconUrl" class="form-label small fw-bold text-muted mb-1">Grouping Icon URL</label>
                        <input asp-for="IconUrl" class="form-control rounded-3 py-2" placeholder="https://example.com/icon.jpg" />
                        <span asp-validation-for="IconUrl" class="text-danger small mt-1 d-block"></span>
                        <small class="form-text text-muted small mt-1">
                            <i class="fas fa-info-circle me-1 text-primary"></i>Provide a direct link to an icon or illustrative thumbnail photo.
                        </small>
                    </div>

                    <!-- Preview -->
                    @if (!string.IsNullOrEmpty(Model.IconUrl))
                    {
                        <div class="mb-4">
                            <span class="small text-muted fw-bold d-block mb-2">Category Icon Preview</span>
                            <img src="@Model.IconUrl" alt="@Model.Name" class="border rounded-3" style="max-height: 100px; object-fit: cover;" onerror="this.style.display='none'" />
                        </div>
                    }

                    <!-- Buttons -->
                    <div class="d-grid gap-2 d-sm-flex">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 py-3 fw-bold rounded-3 shadow">
                            <i class="fas fa-save me-2"></i>Update Category Details
                        </button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-3 fw-semibold shadow-xs">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
