@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<!-- Error Page -->
<div class="d-flex flex-column align-items-center justify-content-center" style="text-align: center; padding: 4rem 2rem; min-height: 60vh;">
    <!-- Error Icon -->
    <div class="animate-scale-in" style="
        width: 110px;
        height: 110px;
        background: linear-gradient(135deg, var(--danger, #ef4444) 0%, color-mix(in srgb, var(--danger, #dc2626) 80%, black) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        box-shadow: 0 12px 35px rgba(239, 68, 68, 0.25);
    ">
        <i class="fas fa-exclamation-triangle" style="color: white; font-size: 3rem;"></i>
    </div>

    <h1 class="fw-bold mb-2" style="color: var(--text-primary); font-size: 2rem;">
        Oops! Something went wrong
    </h1>
    <p class="mb-4" style="color: var(--text-secondary); font-size: 1.1rem; max-width: 480px;">
        We encountered an error while processing your request.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="card border-0 mb-4 rounded-3" style="max-width: 500px; width: 100%; background: var(--bg-tertiary); border: 1px solid var(--border-color) !important;">
            <div class="card-body text-start p-3">
                <p class="mb-0">
                    <strong style="color: var(--text-primary);">Request ID:</strong><br>
                    <code style="word-break: break-all; color: var(--text-muted);">@Model.RequestId</code>
                </p>
            </div>
        </div>
    }

    <!-- Error Message -->
    <div class="alert alert-danger border-0 rounded-3" style="max-width: 500px; width: 100%; margin: 0 auto 2rem;">
        <i class="fas fa-times-circle me-2"></i>
        <strong>Error Details:</strong> An error occurred while processing your request. Our team has been notified.
    </div>

    <!-- Action Buttons -->
    <div class="d-grid gap-2 d-sm-flex justify-content-center" style="max-width: 400px; margin: 0 auto;">
        <a class="btn btn-primary btn-lg rounded-3 px-4" href="/">
            <i class="fas fa-home me-2"></i>Go to Home
        </a>
        <a class="btn btn-outline-primary btn-lg rounded-3 px-4" href="javascript:history.back()" style="border-color: var(--border-color); color: var(--text-primary);">
            <i class="fas fa-arrow-left me-2"></i>Go Back
        </a>
    </div>

    <!-- Help Section -->
    <div class="mt-4">
        <p class="small" style="color: var(--text-muted);">
            Need help? Contact us at <a href="mailto:support@estore.com" class="text-decoration-none fw-semibold" style="color: var(--accent-1);">support@estore.com</a>
        </p>
    </div>
</div>
