@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<!-- Error Page -->
<div style="text-align: center; padding: 4rem 2rem;">
    <!-- Error Icon -->
    <div style="
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        box-shadow: 0 10px 30px rgba(239, 68, 68, 0.3);
    ">
        <i class="fas fa-exclamation-triangle" style="color: white; font-size: 3rem;"></i>
    </div>

    <h1 style="color: #1f2937; font-size: 2rem; margin-bottom: 0.5rem;">
        Oops! Something went wrong
    </h1>
    <p style="color: #6b7280; font-size: 1.1rem; margin-bottom: 2rem;">
        We encountered an error while processing your request.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="card border-0 bg-light mb-4" style="max-width: 500px; margin-left: auto; margin-right: auto;">
            <div class="card-body text-start">
                <p class="mb-0">
                    <strong>Request ID:</strong><br>
                    <code style="word-break: break-all;" class="text-muted">@Model.RequestId</code>
                </p>
            </div>
        </div>
    }

    <!-- Error Message -->
    <div class="alert alert-danger border-0" style="max-width: 500px; margin: 0 auto 2rem;">
        <i class="fas fa-times-circle me-2"></i>
        <strong>Error Details:</strong> An error occurred while processing your request. Our team has been notified.
    </div>

    <!-- Action Buttons -->
    <div class="d-grid gap-2 d-sm-flex justify-content-center" style="max-width: 400px; margin: 0 auto;">
        <a class="btn btn-primary btn-lg" href="/">
            <i class="fas fa-home me-2"></i>Go to Home
        </a>
        <a class="btn btn-outline-primary btn-lg" href="javascript:history.back()">
            <i class="fas fa-arrow-left me-2"></i>Go Back
        </a>
    </div>

    <!-- Help Section -->
    <div class="mt-4">
        <p class="text-muted small">
            Need help? Contact us at <a href="mailto:support@estore.com" class="text-primary">support@estore.com</a>
        </p>
    </div>
</div>
