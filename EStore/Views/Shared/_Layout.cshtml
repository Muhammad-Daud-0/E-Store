<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="E-Store - Premium Online Shopping Experience for Electronics, Audio & Video, and Office Equipment" />
    <title>@ViewData["Title"] - E-Store</title>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap & FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Custom Design Styles -->
    <link rel="stylesheet" href="~/css/modern.css" asp-append-version="true" />
</head>

<body data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
      data-cart-count-url="@Url.Action("GetCartCount", "Cart")"
      data-add-to-cart-url="@Url.Action("AddToCartAjax", "Cart")">
      
    <!-- Global Anti-Forgery Token for AJAX -->
    @Html.AntiForgeryToken()

    <!-- Modern Premium Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
             <div class="container">
                 <a class="navbar-brand fw-bold fs-4 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                     <i class="fas fa-shopping-bag me-2"></i>
                     <span>E-Store</span>
                 </a>
                 <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                         aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                     <span class="navbar-toggler-icon"></span>
                 </button>
                 <div class="collapse navbar-collapse" id="navbarNav">
                     <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                         <li class="nav-item">
                             <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">
                                 <i class="fas fa-store me-1"></i>Shop
                             </a>
                         </li>
                         @if (User.Identity?.IsAuthenticated == true)
                         {
                             <li class="nav-item">
                                 <a class="nav-link text-white fw-semibold position-relative" asp-controller="Cart" asp-action="Index">
                                     <i class="fas fa-shopping-cart me-1"></i>Cart
                                     <span class="cart-badge cart-count-badge" style="display: none;">0</span>
                                 </a>
                             </li>
                             @if (User.IsInRole("Admin"))
                             {
                                 <li class="nav-item">
                                     <a class="nav-link text-white fw-semibold" asp-controller="Admin" asp-action="Dashboard">
                                         <i class="fas fa-cog me-1"></i>Admin Dashboard
                                     </a>
                                 </li>
                             }
                             else
                             {
                                 <li class="nav-item">
                                     <a class="nav-link text-white fw-semibold" asp-controller="User" asp-action="Dashboard">
                                         <i class="fas fa-box me-1"></i>My Orders
                                     </a>
                                 </li>
                             }
                             <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                                 <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                     @Html.AntiForgeryToken()
                                     <button type="submit" class="btn btn-light btn-sm px-3 fw-semibold shadow-sm w-100">
                                         <i class="fas fa-sign-out-alt me-1"></i>Logout
                                     </button>
                                 </form>
                             </li>
                         }
                         else
                         {
                             <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                                 <a class="btn btn-light btn-sm px-3 fw-semibold shadow-sm w-100" asp-controller="Account" asp-action="Login">
                                     <i class="fas fa-sign-in-alt me-1"></i>Login
                                 </a>
                             </li>
                             <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                                 <a class="btn btn-outline-light btn-sm px-3 fw-semibold w-100" asp-controller="Account" asp-action="Register">
                                     <i class="fas fa-user-plus me-1"></i>Register
                                 </a>
                             </li>
                         }
                     </ul>
                 </div>
             </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Modern Premium Footer -->
    <footer class="bg-dark text-white py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="fas fa-shopping-bag text-primary me-2"></i>
                        <span>E-Store</span>
                    </h5>
                    <p class="text-muted small pr-lg-5" style="max-width: 350px;">
                        Providing the highest-quality high-tech gadgets, professional office hardware, and premium audio-visual equipment.
                    </p>
                    <div class="d-flex gap-3 mt-4">
                        <a href="#" class="text-muted"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-muted"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-muted"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-muted"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3 text-uppercase tracking-wider">Quick Links</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none hover-link">
                                <i class="fas fa-chevron-right me-1 fs-xs"></i>Shop Products
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Cart" asp-action="Index" class="text-muted text-decoration-none hover-link">
                                <i class="fas fa-chevron-right me-1 fs-xs"></i>Shopping Cart
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none hover-link">
                                <i class="fas fa-chevron-right me-1 fs-xs"></i>Privacy Policy
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-3 text-uppercase tracking-wider">Contact & Support</h6>
                    <p class="text-muted small mb-2 d-flex align-items-center">
                        <i class="fas fa-envelope text-primary me-2"></i>
                        <span>support@estore.com</span>
                    </p>
                    <p class="text-muted small mb-2 d-flex align-items-center">
                        <i class="fas fa-phone text-primary me-2"></i>
                        <span>1-800-ESTORE</span>
                    </p>
                    <p class="text-muted small d-flex align-items-center">
                        <i class="fas fa-map-marker-alt text-primary me-2"></i>
                        <span>123 Commerce Way, Tech City, USA</span>
                    </p>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="text-muted small mb-0">&copy; @DateTime.Now.Year E-Store. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small hover-link me-3">Terms of Service</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small hover-link">Privacy Statement</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
