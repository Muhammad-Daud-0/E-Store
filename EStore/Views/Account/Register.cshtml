@model RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-container d-flex align-items-center justify-content-center py-5">
    <div class="card border-0 shadow auth-card p-4 p-md-5 rounded-4" style="max-width: 480px; width: 100%;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="mb-3 text-primary" style="font-size: 3.5rem;">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2 class="fw-bold text-dark mb-1">Create Account</h2>
            <p class="text-muted small">Join E-Store and start shopping premium goods</p>
        </div>

        @if (ViewData.ModelState.Values.Any(v => v.Errors.Any()))
        {
            <div class="alert alert-danger mb-4 shadow-xs" role="alert">
                <p class="mb-2 fw-semibold"><i class="fas fa-exclamation-circle me-1 text-danger"></i> Please check the following:</p>
                <ul class="mb-0 ps-3 small text-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Register">
            <!-- Email Field -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-muted mb-1">
                    <i class="fas fa-envelope me-1 text-primary"></i> Email Address
                </label>
                <input asp-for="Email" class="form-control py-2.5 rounded-3" placeholder="name@example.com" required autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                <small class="form-text text-muted small mt-1">We respect your privacy and will never share your email address.</small>
            </div>

            <!-- Password Field -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold text-muted mb-1">
                    <i class="fas fa-lock me-1 text-primary"></i> Password
                </label>
                <input asp-for="Password" class="form-control py-2.5 rounded-3" placeholder="••••••••" required autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                <small class="form-text text-muted small mt-1">
                    <i class="fas fa-info-circle me-1 text-primary"></i> Must be at least 8 characters with digits, uppercase & lowercase.
                </small>
            </div>

            <!-- Confirm Password Field -->
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted mb-1">
                    <i class="fas fa-check-circle me-1 text-primary"></i> Confirm Password
                </label>
                <input asp-for="ConfirmPassword" class="form-control py-2.5 rounded-3" placeholder="••••••••" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Terms Checkbox -->
            <div class="mb-4 form-check d-flex align-items-start gap-2">
                <input type="checkbox" id="Terms" name="Terms" class="form-check-input mt-1" required />
                <label for="Terms" class="form-check-label small text-muted">
                    I agree to the <a asp-controller="Home" asp-action="Privacy" class="text-primary text-decoration-none fw-bold hover-link">Terms of Service</a> and <a asp-controller="Home" asp-action="Privacy" class="text-primary text-decoration-none fw-bold hover-link">Privacy Policy</a>.
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow mb-3">
                <i class="fas fa-user-plus me-2"></i>Create Account
            </button>
        </form>

        <!-- Login Link -->
        <div class="text-center pt-2">
            <p class="text-muted small mb-0">
                Already have an E-Store account? 
                <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none hover-link">
                    Sign in here
                </a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
