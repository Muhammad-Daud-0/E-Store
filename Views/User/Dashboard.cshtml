@model UserDashboardViewModel

@{
    ViewData["Title"] = "My Account";
}

<!-- Premium Dashboard Header -->
<div class="dashboard-header py-5 px-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-9 text-center text-md-start text-white">
            <h1 class="display-5 fw-bold text-white mb-1">
                <i class="fas fa-user-circle me-2"></i>My Dashboard
            </h1>
            <p class="fs-6 opacity-80 mb-0">Manage your shipping address, order fulfillment status, and profile settings.</p>
        </div>
        <div class="col-md-3 text-center text-md-end">
            <div class="d-inline-block glass-card py-3 px-4 text-white">
                <span class="small opacity-75 text-uppercase fw-bold d-block mb-1" style="letter-spacing: 0.05em;">Total Orders</span>
                <h2 class="fw-bold mb-0 text-white">@Model.Orders.Count()</h2>
            </div>
        </div>
    </div>
</div>

@* <!-- Alert Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show p-3 rounded-3 mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show p-3 rounded-3 mb-4" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
} *@

<!-- Tab Navigation Header -->
<ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-content" type="button" role="tab" aria-controls="orders-content" aria-selected="true">
            <i class="fas fa-shopping-bag me-2"></i>Orders & Activity
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-content" type="button" role="tab" aria-controls="profile-content" aria-selected="false">
            <i class="fas fa-user-cog me-2"></i>Profile Settings
        </button>
    </li>
</ul>

<!-- Tab Panel Contents -->
<div class="tab-content text-start" id="dashboardTabsContent">
    
    <!-- Orders Tab -->
    <div class="tab-pane fade show active" id="orders-content" role="tabpanel" aria-labelledby="orders-tab">
        <div class="row g-4 mb-5 text-start">
            <!-- Account Information Card -->
            <div class="col-md-6">
                <div class="card h-100" style="border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
                    <div class="card-header" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); padding: 1rem 1.25rem;">
                        <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                            <i class="fas fa-id-card me-2" style="color: var(--accent-1);"></i>Profile Summary
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--border-color);">
                            <span class="small text-uppercase fw-bold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Email Address</span>
                            <span class="fw-semibold" style="color: var(--text-primary);"><i class="fas fa-envelope me-2" style="color: var(--accent-1);"></i>@Model.User?.Email</span>
                        </div>
                        <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--border-color);">
                            <span class="small text-uppercase fw-bold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Full Name</span>
                            <span class="fw-semibold" style="color: var(--text-primary);"><i class="fas fa-user me-2" style="color: var(--accent-1);"></i>@(Model.User?.FullName ?? "-")</span>
                        </div>
                        <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--border-color);">
                            <span class="small text-uppercase fw-bold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Phone Number</span>
                            <span class="fw-semibold" style="color: var(--text-primary);">
                                <i class="fas fa-phone me-2" style="color: var(--accent-1);"></i>
                                @(string.IsNullOrEmpty(Model.User?.PhoneNumber) ? "Not Provided" : Model.User.PhoneNumber)
                            </span>
                        </div>
                        <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--border-color);">
                            <span class="small text-uppercase fw-bold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Shipping Address</span>
                            <span class="fw-semibold" style="color: var(--text-primary);">@(Model.User?.ShippingAddress ?? "Not Provided")</span>
                        </div>
                        <div class="mb-0">
                            <span class="small text-uppercase fw-bold d-block mb-2" style="color: var(--text-muted); letter-spacing: 0.05em;">City</span>
                            <span class="fw-semibold" style="color: var(--text-primary);">@(Model.User?.City ?? "-")</span>
                        </div>
                        <div class="mb-0">
                            <span class="small text-uppercase fw-bold d-block mb-2" style="color: var(--text-muted); letter-spacing: 0.05em;">Account Status</span>
                            <span class="order-status status-delivered">
                                <i class="fas fa-check-circle me-1"></i>Active Account
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Stats Card -->
            <div class="col-md-6">
                <div class="card h-100" style="border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
                    <div class="card-header" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); padding: 1rem 1.25rem;">
                        <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                            <i class="fas fa-chart-bar me-2" style="color: var(--accent-1);"></i>Shopping Statistics
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4 text-center">
                            <div class="col-6 pb-3" style="border-right: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                                <span class="small text-uppercase fw-semibold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Total Spent</span>
                                <h4 class="fw-bold text-gradient mb-0">$@Model.Orders.Where(o => o.OrderStatus == "Delivered").Sum(o => o.TotalPrice).ToString("F2")</h4>
                            </div>
                            <div class="col-6 pb-3" style="border-bottom: 1px solid var(--border-color);">
                                <span class="small text-uppercase fw-semibold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Items Bought</span>
                                <h4 class="fw-bold text-gradient mb-0">@Model.Orders.Where(o => o.OrderStatus == "Delivered").Sum(o => o.OrderItems.Sum(oi => oi.Quantity))</h4>
                            </div>
                            <div class="col-6 pt-2" style="border-right: 1px solid var(--border-color);">
                                <span class="small text-uppercase fw-semibold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Pending Orders</span>
                                <h4 class="fw-bold mb-0" style="color: var(--warning);">@Model.Orders.Count(o => o.OrderStatus.ToLower() == "pending")</h4>
                            </div>
                            <div class="col-6 pt-2">
                                <span class="small text-uppercase fw-semibold d-block mb-1" style="color: var(--text-muted); letter-spacing: 0.05em;">Delivered Orders</span>
                                <h4 class="fw-bold mb-0" style="color: var(--success);">@Model.Orders.Count(o => o.OrderStatus.ToLower() == "delivered")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order History Listing -->
        <div class="text-start">
            <div class="mb-4">
                <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                    <i class="fas fa-box me-2" style="color: var(--accent-1);"></i>Your Purchase History
                </h3>
                <p class="small mb-0" style="color: var(--text-muted);">Expand each order to view complete item summaries and shipping progress</p>
            </div>

            @if (Model.Orders.Any())
            {
                <div class="row g-3">
                    @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                    {
                        <div class="col-12">
                            <div class="order-card">
                                <!-- Accordion Order Header Toggle -->
                                <div class="p-3 collapsed d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" 
                                     data-bs-toggle="collapse" data-bs-target="#order-collapse-@order.Id"
                                     aria-expanded="false" aria-controls="order-collapse-@order.Id" style="cursor: pointer; background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); transition: background-color 0.2s;">
                                    
                                    <div>
                                        <h6 class="fw-bold mb-1" style="color: var(--text-primary);">Order #@order.Id</h6>
                                        <span class="small" style="color: var(--text-muted);"><i class="fas fa-calendar-alt me-1" style="color: var(--accent-1);"></i>@order.OrderDate.ToString("MMMM dd, yyyy h:mm tt")</span>
                                    </div>
                                    
                                    <div class="d-flex align-items-center gap-3">
                                        @{
                                            var statusClass = order.OrderStatus.ToLower() switch
                                            {
                                                "pending" => "status-pending",
                                                "processing" => "status-processing",
                                                "shipped" => "status-shipped",
                                                "delivered" => "status-delivered",
                                                "cancelled" => "status-cancelled",
                                                _ => "status-pending"
                                            };
                                        }
                                        <span class="order-status @statusClass">
                                            <i class="fas fa-info-circle me-1"></i>@order.OrderStatus
                                        </span>

                                        <div class="text-md-end ms-2">
                                            <span class="small d-block" style="font-size: 0.7rem; color: var(--text-muted);">Order Total</span>
                                            <strong class="text-gradient fs-5">$@order.TotalPrice.ToString("F2")</strong>
                                        </div>
                                        
                                        <i class="fas fa-chevron-down transition-chevron ms-2" style="color: var(--text-muted);"></i>
                                    </div>
                                </div>

                                <!-- Accordion Order Details Body -->
                                <div class="collapse" id="order-collapse-@order.Id">
                                    <div class="p-4" style="background: var(--bg-card);">
                                        <!-- Order Items List -->
                                        <div class="rounded-3 overflow-hidden mb-4" style="border: 1px solid var(--border-color);">
                                            <div class="px-3 py-2" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                                                <span class="fw-bold small" style="color: var(--text-primary);"><i class="fas fa-shopping-basket me-2" style="color: var(--accent-1);"></i>Items in this Order</span>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0 small">
                                                    <thead>
                                                        <tr>
                                                            <th class="ps-3 py-2">Product Name</th>
                                                            <th class="text-end py-2">Unit Price</th>
                                                            <th class="text-center py-2">Quantity</th>
                                                            <th class="text-end pe-3 py-2">Subtotal</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in order.OrderItems)
                                                        {
                                                            <tr>
                                                                <td class="ps-3 fw-semibold" style="color: var(--text-primary);">@item.ProductName</td>
                                                                <td class="text-end" style="color: var(--text-muted);">$@item.UnitPrice.ToString("F2")</td>
                                                                <td class="text-center fw-semibold" style="color: var(--text-primary);">@item.Quantity</td>
                                                                <td class="text-end pe-3 fw-bold text-gradient">$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- Shipping Address Details -->
                                        <div class="rounded-3 p-3 mb-4" style="background: var(--bg-tertiary); border: 1px solid var(--border-color);">
                                            <h6 class="fw-bold mb-2" style="color: var(--text-primary);"><i class="fas fa-truck me-2" style="color: var(--accent-1);"></i>Shipping Details</h6>
                                            <div class="row g-2 small" style="color: var(--text-secondary);">
                                                <div class="col-sm-6"><strong>Receiver Name:</strong> @order.CustomerName</div>
                                                <div class="col-sm-6"><strong>Contact Phone:</strong> @order.PhoneNumber</div>
                                                <div class="col-sm-6"><strong>Destination City:</strong> @order.City</div>
                                                <div class="col-sm-6"><strong>Delivery Address:</strong> @order.ShippingAddress</div>
                                            </div>
                                        </div>

                                        <!-- Progress Fulfillment Tracker -->
                                        <div>
                                            <h6 class="fw-bold mb-3" style="color: var(--text-primary);"><i class="fas fa-map-marker-alt me-2" style="color: var(--accent-1);"></i>Delivery Fulfillment Status</h6>
                                            @if (order.OrderStatus == "Cancelled")
                                            {
                                                <div class="d-flex align-items-center gap-3 p-3 rounded" style="background: var(--danger-bg); border: 1px solid var(--danger-border); color: var(--danger);">
                                                    <i class="fas fa-times-circle fs-3"></i>
                                                    <div>
                                                        <p class="fw-bold mb-0">Fulfillment Cancelled</p>
                                                        <p class="small mb-0 opacity-80">This order was cancelled. Items have been returned to warehouse inventory.</p>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row text-center g-2 position-relative pt-2">
                                                    @{
                                                        var statuses = new[] { "Pending", "Processing", "Shipped", "Delivered" };
                                                        var currentStatusIndex = Array.IndexOf(statuses, order.OrderStatus);
                                                    }
                                                    @for (int i = 0; i < statuses.Length; i++)
                                                    {
                                                        <div class="col-3">
                                                            <div class="progress-step @(i <= currentStatusIndex ? "completed" : "pending") d-inline-flex align-items-center justify-content-center rounded-circle mb-2">
                                                                @if (i <= currentStatusIndex)
                                                                {
                                                                    <i class="fas fa-check" style="font-size: 0.8rem;"></i>
                                                                }
                                                                else
                                                                {
                                                                    <span class="fw-bold" style="font-size: 0.85rem;">@(i + 1)</span>
                                                                }
                                                            </div>
                                                            <p class="small mb-0 fw-bold" style="font-size: 0.8rem; color: @(i <= currentStatusIndex ? "var(--text-primary)" : "var(--text-muted)");">@statuses[i]</p>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <!-- Cancellation Button (Only visible for Pending status) -->
                                            @if (order.OrderStatus == "Pending")
                                            {
                                                <div class="mt-4 pt-3 text-end" style="border-top: 1px solid var(--border-color);">
                                                    <form method="post" asp-controller="User" asp-action="CancelOrder" data-order-id="@order.Id" class="cancel-order-form d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <button type="submit" class="btn btn-outline-danger px-4 py-2 rounded-3 fw-semibold">
                                                            <i class="fas fa-times-circle me-1"></i>Cancel Order
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty Orders State -->
                <div class="text-center py-5 rounded-3" style="background: var(--bg-card); border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
                    <i class="fas fa-box-open display-1 mb-3" style="color: var(--text-muted);"></i>
                    <h4 class="fw-bold" style="color: var(--text-primary);">No orders yet</h4>
                    <p class="mb-4" style="max-width: 400px; margin: 0 auto; color: var(--text-muted);">You have not placed any orders yet. Discover our latest catalog of high-tech gear and shop today!</p>
                    <a class="btn btn-primary btn-lg px-5 py-3 rounded-3 mt-2" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-store me-2"></i>Start Shopping
                    </a>
                </div>
            }
        </div>
    </div>
    
    <!-- Profile Settings Tab -->
    <div class="tab-pane fade" id="profile-content" role="tabpanel" aria-labelledby="profile-tab">
        <div class="row g-4">
            
            <!-- Update Profile Info Card -->
            <div class="col-lg-6">
                <div class="card h-100" style="border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
                    <div class="card-header" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); padding: 1rem 1.25rem;">
                        <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                            <i class="fas fa-user-edit me-2" style="color: var(--accent-1);"></i>Personal Details
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-controller="User" asp-action="UpdateProfile">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/User/Dashboard?tab=profile" />
                            <div class="mb-3">
                                <label class="form-label" for="profileFullName">Full Name</label>
                                <input type="text" id="profileFullName" name="fullName" class="form-control" value="@Model.User?.FullName" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="profileAddress">Shipping Address</label>
                                <input type="text" id="profileAddress" name="shippingAddress" class="form-control" value="@Model.User?.ShippingAddress" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="profileCity">City</label>
                                <input type="text" id="profileCity" name="city" class="form-control" value="@Model.User?.City" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="profileEmail">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input type="email" id="profileEmail" name="email" class="form-control" value="@Model.User?.Email" required />
                                </div>
                                <span class="form-text">Changing your email address will also change your login credentials.</span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label" for="profilePhone">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    <input type="tel" id="profilePhone" name="phoneNumber" class="form-control" value="@Model.User?.PhoneNumber" placeholder="e.g. +1 555-0199" />
                                </div>
                                <span class="form-text">Used for shipping updates and order tracking delivery contacts.</span>
                            </div>

                            <button type="submit" class="btn btn-primary px-4 py-2 w-100 rounded-3">
                                <i class="fas fa-save me-2"></i>Save Personal Changes
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
            <!-- Update Password Card -->
            <div class="col-lg-6">
                <div class="card h-100" style="border: 1px solid var(--border-color); box-shadow: var(--shadow-md);">
                    <div class="card-header" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); padding: 1rem 1.25rem;">
                        <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                            <i class="fas fa-shield-alt me-2" style="color: var(--accent-1);"></i>Security & Password
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-controller="User" asp-action="ChangePassword">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/User/Dashboard?tab=profile" />
                            
                            <div class="mb-3">
                                <label class="form-label" for="currentPassword">Current Password</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    <input type="password" id="currentPassword" name="oldPassword" class="form-control" placeholder="••••••••" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="newPassword">New Password</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-key"></i></span>
                                    <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Min. 8 characters" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label" for="confirmPassword">Confirm New Password</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-key"></i></span>
                                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Repeat new password" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-outline-primary px-4 py-2 w-100 rounded-3">
                                <i class="fas fa-lock-open me-2"></i>Update Password
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Cancel Order Confirmation Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); color: var(--text-primary); border:1px solid var(--border-color);">
            <div class="modal-header" style="border-bottom:1px solid var(--border-color);">
                <h5 class="modal-title" id="cancelOrderModalLabel"><i class="fas fa-exclamation-triangle me-2" style="color: var(--warning);"></i>Cancel Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="cancelOrderMessage">Are you sure you want to cancel order #<strong id="cancelOrderNumber"></strong>? This will restore stock in the inventory.</p>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--border-color);">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep Order</button>
                <button type="button" id="confirmCancelOrderBtn" class="btn btn-danger">Yes, Cancel Order</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Read "tab" query parameter from URL (e.g. ?tab=profile)
            var params = new URLSearchParams(window.location.search);
            var activeTab = params.get('tab');
            if (activeTab) {
                var tabBtn = document.getElementById(activeTab + '-tab');
                if (tabBtn) {
                    var tab = new bootstrap.Tab(tabBtn);
                    tab.show();
                }
            }

            // Cancel order modal handling
            var cancelModalEl = document.getElementById('cancelOrderModal');
            var cancelModal = cancelModalEl ? new bootstrap.Modal(cancelModalEl) : null;
            var pendingCancelForm = null;

            document.querySelectorAll('.cancel-order-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    pendingCancelForm = this;
                    var orderId = this.dataset.orderId || this.querySelector('input[name="orderId"]')?.value;
                    var numberEl = document.getElementById('cancelOrderNumber');
                    if (numberEl) numberEl.textContent = orderId;
                    if (cancelModal) cancelModal.show();
                });
            });

            var confirmBtn = document.getElementById('confirmCancelOrderBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    if (pendingCancelForm) {
                        if (cancelModal) cancelModal.hide();
                        // submit the original form
                        pendingCancelForm.submit();
                        pendingCancelForm = null;
                    }
                });
            }

            if (cancelModalEl) {
                cancelModalEl.addEventListener('hidden.bs.modal', function () {
                    pendingCancelForm = null;
                });
            }
        });
    </script>
}