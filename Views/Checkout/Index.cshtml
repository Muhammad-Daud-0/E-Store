@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<!-- Checkout Header -->
<div class="mb-4 animate-fade-in-up">
    <h1 class="fw-bold mb-1" style="color: var(--text-primary);">
        <i class="fas fa-credit-card me-2 text-gradient"></i>Checkout
    </h1>
    <p class="mb-0" style="color: var(--text-muted); font-size: 0.92rem;">Provide your shipping address and billing details to complete your order</p>
</div>

<!-- Checkout Container -->
<div class="row g-4">
    <!-- Main Checkout Form -->
    <div class="col-lg-8 animate-fade-in-up">
        <!-- Backend transaction validation errors -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-3 mb-4 small fw-semibold" role="alert" style="background: var(--danger-bg); border: 1px solid var(--danger-border); color: var(--danger); box-shadow: var(--shadow-sm);"></div>

        <form method="post" asp-controller="Checkout" asp-action="ProcessCheckout">
            @Html.AntiForgeryToken()

            <!-- Order Review Section -->
            <div class="card border-0 mb-4 overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color) !important; box-shadow: var(--shadow-md); border-radius: var(--radius-lg);">
                <div class="card-header p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-list" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Order Review
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3 py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Product</th>
                                    <th class="text-end py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Unit Price</th>
                                    <th class="text-end py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Quantity</th>
                                    <th class="text-end pe-3 py-2" style="background: var(--bg-tertiary); color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color);">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cart?.Items != null)
                                {
                                    @foreach (var item in Model.Cart.Items)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold" style="color: var(--text-primary); border-bottom: 1px solid var(--border-color);">@item.ProductName</td>
                                            <td class="text-end" style="color: var(--text-secondary); border-bottom: 1px solid var(--border-color);">$@item.Price.ToString("F2")</td>
                                            <td class="text-end fw-semibold" style="color: var(--text-primary); border-bottom: 1px solid var(--border-color);">@item.Quantity</td>
                                            <td class="text-end pe-3 fw-bold text-gradient" style="border-bottom: 1px solid var(--border-color);">$@item.Subtotal.ToString("F2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Shipping Contact Fields Section -->
            <div class="card border-0 mb-4 overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color) !important; box-shadow: var(--shadow-md); border-radius: var(--radius-lg);">
                <!-- Gradient top bar -->
                <div style="height: 4px; background: var(--accent-gradient);"></div>
                <div class="card-header p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-shipping-fast" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Shipping Information
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-bold mb-1" style="color: var(--text-secondary);">Full Name</label>
                            <input asp-for="CustomerName" class="form-control py-2" placeholder="John Doe" required style="border-radius: var(--radius-md); border: 1.5px solid var(--border-color); background: var(--bg-input); color: var(--text-primary);" />
                            <span asp-validation-for="CustomerName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Email Address -->
                        <div class="col-md-6">
                            <label asp-for="CustomerEmail" class="form-label small fw-bold mb-1" style="color: var(--text-secondary);">Email Address</label>
                            <input asp-for="CustomerEmail" class="form-control py-2" readonly style="border-radius: var(--radius-md); border: 1.5px solid var(--border-color); background: var(--bg-tertiary); color: var(--text-muted);" />
                            <span asp-validation-for="CustomerEmail" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Shipping Address -->
                        <div class="col-12">
                            <label asp-for="ShippingAddress" class="form-label small fw-bold mb-1" style="color: var(--text-secondary);">Shipping Address</label>
                            <input asp-for="ShippingAddress" class="form-control py-2" placeholder="123 Main St, Apartment or Suite" required style="border-radius: var(--radius-md); border: 1.5px solid var(--border-color); background: var(--bg-input); color: var(--text-primary);" />
                            <span asp-validation-for="ShippingAddress" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-bold mb-1" style="color: var(--text-secondary);">City</label>
                            <input asp-for="City" class="form-control py-2" placeholder="Tech City" required style="border-radius: var(--radius-md); border: 1.5px solid var(--border-color); background: var(--bg-input); color: var(--text-primary);" />
                            <span asp-validation-for="City" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold mb-1" style="color: var(--text-secondary);">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control py-2" placeholder="+1 (555) 000-0000" required style="border-radius: var(--radius-md); border: 1.5px solid var(--border-color); background: var(--bg-input); color: var(--text-primary);" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Simulation Panel -->
            <div class="card border-0 mb-4 overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border-color) !important; box-shadow: var(--shadow-md); border-radius: var(--radius-lg);">
                <div class="card-header p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                        <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                            <i class="fas fa-credit-card" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                        </span>
                        Simulated Payment Method
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="form-check d-flex align-items-center gap-2">
                        <input class="form-check-input mt-0" type="radio" name="paymentMethod" id="creditCard" value="credit-card" checked>
                        <label class="form-check-label small" for="creditCard">
                            <strong style="color: var(--text-primary);">Credit or Debit Card</strong>
                            <span class="d-block small mt-1" style="color: var(--text-muted);">Simulate payment using Visa, Mastercard, or AMEX</span>
                        </label>
                    </div>
                    <hr class="my-4" style="border-color: var(--border-color);">
                    <div class="d-flex align-items-center p-3 mb-0" role="alert" style="background: var(--warning-bg); border: 1px solid var(--warning-border); border-radius: var(--radius-md);">
                        <i class="fas fa-vial fs-5 me-3 flex-shrink-0" style="color: var(--warning);"></i>
                        <div class="small fw-semibold" style="color: var(--warning);">This is a demo store checkout simulation. No actual credit card billing will be processed.</div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2 d-sm-flex">
                <a class="btn btn-outline-secondary px-4 py-2 fw-semibold" asp-controller="Cart" asp-action="Index" style="border-radius: var(--radius-md);">
                    <i class="fas fa-arrow-left me-2"></i>Back to Cart
                </a>
                <button type="submit" class="btn btn-primary btn-lg flex-grow-1 py-3 fw-bold" style="border-radius: var(--radius-md); box-shadow: 0 8px 25px var(--accent-glow);">
                    <i class="fas fa-check-circle me-2"></i>Complete Place Order
                </button>
            </div>
        </form>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="col-lg-4 animate-fade-in-up delay-1">
        <div class="glass-card overflow-hidden mb-4" style="position: sticky; top: 90px; z-index: 10; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);">
            <!-- Gradient top bar -->
            <div style="height: 4px; background: var(--accent-gradient);"></div>
            <div class="p-3" style="background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                <h6 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
                    <span class="d-inline-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--accent-glow);">
                        <i class="fas fa-receipt" style="color: var(--accent-1); font-size: 0.85rem;"></i>
                    </span>
                    Order Summary
                </h6>
            </div>
            <div class="p-4">
                <!-- Items Count -->
                <div class="d-flex justify-content-between pb-3 mb-3 small" style="border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted);">Subtotal Items (@(Model.Cart?.Items?.Sum(i => i.Quantity) ?? 0))</span>
                    <span class="fw-bold" style="color: var(--text-primary);">$@(Model.Cart?.Total.ToString("F2") ?? "0.00")</span>
                </div>

                <!-- Shipping -->
                <div class="d-flex justify-content-between pb-3 mb-3 small" style="border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted);">Shipping</span>
                    <span class="fw-bold" style="color: var(--success);">Free Delivery</span>
                </div>

                <!-- Tax -->
                <div class="d-flex justify-content-between pb-3 mb-3 small" style="border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted);">Estimated Tax</span>
                    <span class="fw-bold" style="color: var(--text-primary);">$0.00</span>
                </div>

                <!-- Total -->
                <div class="d-flex justify-content-between pt-2 mb-4 fs-5 fw-bold">
                    <span style="color: var(--text-primary);">Total Amount</span>
                    <span class="text-gradient">$@(Model.Cart?.Total.ToString("F2") ?? "0.00")</span>
                </div>

                <!-- Protected Secure Trust Badges -->
                <div class="p-3" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex align-items-center gap-2" style="color: var(--text-secondary);">
                            <span class="d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--success-bg); flex-shrink: 0;">
                                <i class="fas fa-shield-alt" style="color: var(--success); font-size: 0.85rem;"></i>
                            </span>
                            Secure checkout server
                        </div>
                        <div class="d-flex align-items-center gap-2" style="color: var(--text-secondary);">
                            <span class="d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--success-bg); flex-shrink: 0;">
                                <i class="fas fa-lock" style="color: var(--success); font-size: 0.85rem;"></i>
                            </span>
                            256-bit SSL encrypted connection
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
